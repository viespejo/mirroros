{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "248",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "245"
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "255",
    "bold": true
  },
  "h1": {
    "prefix": "",
    "suffix": "",
    "color": "255",
    "bold": true
  },
  "h2": {
    "prefix": "",
    "color": "255",
    "bold": true
  },
  "h3": {
    "prefix": "",
    "color": "255",
    "bold": true
  },
  "h4": {
    "prefix": "",
    "color": "255",
    "bold": true
  },
  "h5": {
    "prefix": "",
    "color": "255",
    "bold": true
  },
  "h6": {
    "prefix": "",
    "color": "248",
    "bold": true
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true,
    "color": "255"
  },
  "hr": {
    "color": "245",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[x] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "250",
    "underline": true
  },
  "link_text": {
    "color": "255",
    "bold": true
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "0",
    "background_color": "255"
  },
  "code_block": {
    "color": "250",
    "margin": 2
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n> "
  },
  "html_block": {},
  "html_span": {}
}
