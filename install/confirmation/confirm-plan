#!/usr/bin/bash
set -Eeuo pipefail
umask 077

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd -P)"
FLOW_CODE_ROOT="$(cd -- "${SCRIPT_DIR}/../.." && pwd -P)"

readonly REQUIRED_FILES=(
  install/confirmation/cli.mjs
  install/confirmation/compare-safety.mjs
  install/confirmation/edit-choices.mjs
  install/confirmation/outcomes.mjs
  install/confirmation/review-content.mjs
  install/confirmation/style.json
  install/confirmation/validate-records.mjs
  install/confirmation/write-records.mjs
  install/confirmation/lib/flow.sh
  install/confirmation/lib/ui.sh
  install/discovery/discover
  install/plan/plan
)

print_help() {
  cat <<'EOF'
MirrorOS install apply — interactive, confirmed installation flow
Usage: install apply [--plan <file>] [--output <dir>]
       install apply --help
Purpose: Choose a target, discover it read-only, generate and edit an installation plan, review it on one dashboard, and require a confirmation bound to the disk and the plan digest.
Prerequisites: an interactive terminal, Gum 2.x, the prerequisites of install discover, and a ready network.
Inputs: --plan reviews an existing installation plan instead of generating one; the target comes from the plan. --output names an absent or empty run directory; the default is evidence/install/<run-id>/. No option confirms anything, and none disables the prompts.
Consequential effects: None in this version. The installation engine is not part of it, so even a valid confirmation changes nothing on the target. No elevation is invoked and no secret value is requested.
Evidence: apply-run.json, approval-record.json, discovery/initial/, discovery/final/ when reached, plans/NN/ with choices.json, and apply.log.
Normalized exit outcomes:
  2: invalid input, no interactive terminal, or an approved, blocked, or invalidated run
  3: explicit user cancellation or a confirmation that did not match
  5: an external tool failed unexpectedly
  6: damaged embedded code or Gum that is not qualified
Documentation: docs/procedures/install.md
EOF
}

usage_error() {
  printf 'MirrorOS install apply: %s\n' "$1" >&2
  printf '%s\n' 'Usage: install apply [--plan <file>] [--output <dir>]; see install apply --help.' >&2
  exit 2
}

FLOW_PLAN_ARG=''
FLOW_OUTPUT_ARG=''
if [[ "$#" -eq 1 && "$1" == '--help' ]]; then
  print_help
  exit 0
fi
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --plan)
      [[ "$#" -ge 2 && -n "$2" && "$2" != --* ]] || usage_error '--plan requires a file.'
      [[ -z "$FLOW_PLAN_ARG" ]] || usage_error '--plan may be given only once.'
      FLOW_PLAN_ARG="$2"
      shift 2
      ;;
    --output)
      [[ "$#" -ge 2 && -n "$2" && "$2" != --* ]] || usage_error '--output requires a directory.'
      [[ -z "$FLOW_OUTPUT_ARG" ]] || usage_error '--output may be given only once.'
      FLOW_OUTPUT_ARG="$2"
      shift 2
      ;;
    *)
      usage_error "unsupported argument: $1"
      ;;
  esac
done
[[ -z "$FLOW_PLAN_ARG" || -f "$FLOW_PLAN_ARG" ]] || usage_error "--plan is not a file: ${FLOW_PLAN_ARG}"

damaged() {
  printf 'MirrorOS install apply: the embedded MirrorOS code is incomplete or damaged: %s\n' "$1" >&2
  printf '%s\n' 'Next step: rebuild or re-clone the installation medium and rerun apply.' >&2
  exit 6
}

# The terminal check comes first: without a terminal nothing is asked, discovered, or written.
# shellcheck disable=SC1091 # The library path is resolved from BASH_SOURCE to support arbitrary working directories.
source "${SCRIPT_DIR}/lib/ui.sh" 2> /dev/null || damaged 'install/confirmation/lib/ui.sh could not be loaded.'
ui_tty_precheck || exit 2

for required in "${REQUIRED_FILES[@]}"; do
  [[ -f "${FLOW_CODE_ROOT}/${required}" ]] || damaged "${required} is missing."
done
[[ -d "${FLOW_CODE_ROOT}/targets" ]] || damaged 'targets/ is missing.'
if ! command -v node > /dev/null 2>&1; then
  printf '%s\n' 'MirrorOS install apply: Node.js is not available.' >&2
  printf '%s\n' 'Next step: check that nodejs is installed and rerun apply.' >&2
  exit 5
fi

# shellcheck disable=SC1091 # The library path is resolved from BASH_SOURCE to support arbitrary working directories.
source "${SCRIPT_DIR}/lib/flow.sh" 2> /dev/null || damaged 'install/confirmation/lib/flow.sh could not be loaded.'
flow_main
