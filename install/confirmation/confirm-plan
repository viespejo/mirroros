#!/usr/bin/bash
set -Eeuo pipefail
umask 077

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd -P)"
FLOW_CODE_ROOT="$(cd -- "${SCRIPT_DIR}/../.." && pwd -P)"

readonly REQUIRED_FILES=(
  install/confirmation/assistant.mjs
  install/confirmation/banner.txt
  install/confirmation/cli.mjs
  install/confirmation/compare-safety.mjs
  install/confirmation/edit-choices.mjs
  install/confirmation/instructions/live-wifi.txt
  install/confirmation/outcomes.mjs
  install/confirmation/regional-mirrors.mjs
  install/confirmation/review-content.mjs
  install/confirmation/validate-records.mjs
  install/confirmation/write-records.mjs
  install/confirmation/lib/flow.sh
  install/confirmation/lib/live.sh
  install/confirmation/lib/screens.sh
  install/confirmation/lib/ui.sh
  install/discovery/discover
  install/discovery/discover-storage
  install/engine/apply
  install/engine/engine-record.mjs
  install/engine/load-plan.mjs
  install/engine/lib/accounts.sh
  install/engine/lib/boot.sh
  install/engine/lib/common.sh
  install/engine/lib/precheck.sh
  install/engine/lib/storage.sh
  install/engine/lib/system.sh
  install/plan/plan
)

print_help() {
  cat <<'EOF'
MirrorOS install — guided live installer
Usage: mirroros-install [--plan <file>] [--output <dir>]
       mirroros-install discover [--target <id>] [--output <dir>]
       mirroros-install plan --facts <file> [--choices <file>] [--output <dir>]
       mirroros-install --help
Purpose: Prepare the live environment, discover the machine automatically, collect the installation choices, generate and review an installation plan, and require a confirmation bound to the machine, the disk, and the plan. The same assistant starts on tty1 of the live ISO.
Prerequisites: a colored interactive console (TERM set and not dumb, NO_COLOR unset), Gum 2.x, the prerequisites of discover, and no other installation run in progress. The live session runs as root; nothing is reachable without the confirmation and the password.
Inputs: --plan reviews an existing installation plan of the current format and of this artifact's code identity instead of the configuration screens; it is validated, copied, and compared with fresh discovery. --output names an absent or empty run directory; the default is evidence/install/<run-id>/. No option confirms anything, and none disables the prompts.
Consequential effects: After the bound confirmation, the account password, and a final revalidation, the installation engine ERASES the confirmed disk and installs the base system. A failure after that point leaves the disk partially modified; retrying is a new run. The single account password is requested twice with a protected prompt and is never written anywhere. No elevation is invoked and no Wi-Fi credential is requested. The live keyboard changes only this live session. Restarting or powering off happens only when you choose it.
Evidence: install-run.json, approval-record.json, install.log, discovery/initial/, discovery/final/ when reached, plans/NN/ with choices.json, and engine/ when the engine started. Evidence is written with 0700 directories and 0600 files.
Normalized exit outcomes:
  0: the base system was installed (postconditions are not verified in this version)
  2: invalid input, no supported terminal, a concurrent run, or a blocked or invalidated run
  3: explicit user cancellation, including a confirmation that did not match
  5: an external tool failed unexpectedly, including an engine operation
  6: damaged embedded code or assets, or Gum that is not qualified
  128+n: a signal interrupted the engine
Documentation: docs/procedures/install.md
EOF
}

usage_error() {
  printf 'MirrorOS install: %s\n' "$1" >&2
  printf '%s\n' 'Usage: mirroros-install [--plan <file>] [--output <dir>]; see mirroros-install --help.' >&2
  exit 2
}

FLOW_PLAN_ARG=''
FLOW_OUTPUT_ARG=''
if [[ "$#" -eq 1 && "$1" == '--help' ]]; then
  print_help
  exit 0
fi
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --plan)
      [[ "$#" -ge 2 && -n "$2" && "$2" != --* ]] || usage_error '--plan requires a file.'
      [[ -z "$FLOW_PLAN_ARG" ]] || usage_error '--plan may be given only once.'
      FLOW_PLAN_ARG="$2"
      shift 2
      ;;
    --output)
      [[ "$#" -ge 2 && -n "$2" && "$2" != --* ]] || usage_error '--output requires a directory.'
      [[ -z "$FLOW_OUTPUT_ARG" ]] || usage_error '--output may be given only once.'
      FLOW_OUTPUT_ARG="$2"
      shift 2
      ;;
    *)
      usage_error "unsupported argument: $1"
      ;;
  esac
done
[[ -z "$FLOW_PLAN_ARG" || -f "$FLOW_PLAN_ARG" ]] || usage_error "--plan is not a file: ${FLOW_PLAN_ARG}"

damaged() {
  printf 'MirrorOS install: the embedded MirrorOS code is incomplete or damaged: %s\n' "$1" >&2
  printf '%s\n' 'Next step: rebuild or re-clone the installation medium and rerun mirroros-install.' >&2
  exit 6
}

# The terminal gate comes first: without a supported terminal nothing is asked, discovered, or written.
# shellcheck disable=SC1091 # The library path is resolved from BASH_SOURCE to support arbitrary working directories.
source "${SCRIPT_DIR}/lib/ui.sh" 2> /dev/null || damaged 'install/confirmation/lib/ui.sh could not be loaded.'
ui_terminal_gate || exit 2

# The installer lock comes right after the terminal gate: before the Gum check, the start-of-run cleanup, discovery,
# and the run directory. A second run exits 2 on stderr only and touches nothing. The descriptor stays open for the
# whole run and is inherited by the engine as fd 4; the kernel releases the lock when this process ends.
FLOW_ENGINE_ROOT="${MIRROROS_ENGINE_RUN_ROOT:-/run/mirroros}"
FLOW_ENGINE_ROOT="${FLOW_ENGINE_ROOT%/}"
if ! { install -d -m 0700 -- "$FLOW_ENGINE_ROOT" && exec 4> "${FLOW_ENGINE_ROOT}/install.lock"; } 2> /dev/null; then
  printf '%s\n' 'MirrorOS install: the installer lock cannot be opened.' 'Next step: check that /run/mirroros is writable and rerun mirroros-install; nothing was asked or changed.' >&2
  exit 5
fi
if ! flock -n 4; then
  printf '%s\n' 'MirrorOS install: install_already_running: another installation run holds the installer lock.' 'Next step: wait for that run to end, or finish it in its console; nothing was asked or changed.' >&2
  exit 2
fi

for required in "${REQUIRED_FILES[@]}"; do
  [[ -f "${FLOW_CODE_ROOT}/${required}" ]] || damaged "${required} is missing."
done
[[ -d "${FLOW_CODE_ROOT}/targets" ]] || damaged 'targets/ is missing.'
if ! command -v node > /dev/null 2>&1; then
  printf '%s\n' 'MirrorOS install: Node.js is not available.' >&2
  printf '%s\n' 'Next step: check that nodejs is installed and rerun mirroros-install.' >&2
  exit 5
fi

for library in live screens flow; do
  # shellcheck disable=SC1090 # The library path is resolved from BASH_SOURCE to support arbitrary working directories.
  source "${SCRIPT_DIR}/lib/${library}.sh" 2> /dev/null || damaged "install/confirmation/lib/${library}.sh could not be loaded."
done
flow_main
