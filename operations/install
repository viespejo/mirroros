#!/usr/bin/bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd -P)"
HELPER_PATH="${SCRIPT_DIR}/lib/lifecycle-discovery.sh"

# shellcheck disable=SC1090 # The helper path is resolved from BASH_SOURCE to support arbitrary working directories and paths with spaces.
if [[ ! -f "$HELPER_PATH" ]] || ! source "$HELPER_PATH"; then
  printf '%s\n' \
    'MirrorOS: incomplete or damaged checkout; the lifecycle discovery helper could not be loaded.' \
    'Restore the helper from Git or re-clone the repository.' >&2
  exit 6
fi

if [[ "${1:-}" == 'discover' ]]; then
  DISCOVER_PATH="${SCRIPT_DIR}/../install/discovery/discover"
  if [[ ! -x "$DISCOVER_PATH" ]]; then
    printf '%s\n' \
      'MirrorOS: incomplete or damaged checkout; the discovery orchestrator could not be found.' \
      'Restore install/discovery from Git or re-clone the repository.' >&2
    exit 6
  fi
  shift
  exec "$DISCOVER_PATH" "$@"
fi

if [[ "${1:-}" == 'plan' ]]; then
  PLAN_PATH="${SCRIPT_DIR}/../install/plan/plan"
  if [[ ! -x "$PLAN_PATH" ]]; then
    printf '%s\n' \
      'MirrorOS: incomplete or damaged checkout; the plan orchestrator could not be found.' \
      'Restore install/plan from Git or re-clone the repository.' >&2
    exit 6
  fi
  shift
  exec "$PLAN_PATH" "$@"
fi

# Without a subcommand, the guided installer starts. There is no public apply command and no bypass flag.
if [[ "$#" -eq 0 || "${1:-}" == '--plan' || "${1:-}" == '--output' ]]; then
  GUIDED_PATH="${SCRIPT_DIR}/../install/confirmation/confirm-plan"
  if [[ ! -x "$GUIDED_PATH" ]]; then
    printf '%s\n' \
      'MirrorOS: incomplete or damaged checkout; the guided installer could not be found.' \
      'Restore install/confirmation from Git or re-clone the repository.' >&2
    exit 6
  fi
  exec "$GUIDED_PATH" "$@"
fi

if lifecycle_discovery_main \
  'install' \
  'Run the guided live installer: prepare the live environment, discover the machine, collect choices, review an installation plan, and require a bound confirmation. Also provides the discover and plan components.' \
  'A colored interactive console of the live ISO; external backup, rescue media, and a known-good ISO are required before physical migration. Reference-VM qualification must precede physical installation.' \
  'Optional --plan <file> and --output <dir>; the machine is discovered automatically. discover and plan have their own inputs.' \
  'The installation engine is not part of this version: the guided installer changes no installation disk, collects no password, and ends at the engine boundary.' \
  'Run-associated output is written under evidence/install/<run-id>/ or --output: install-run.json, approval-record.json, and install.log.' \
  "$@"; then
  exit 0
else
  exit "$?"
fi
