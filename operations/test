#!/usr/bin/bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPOSITORY_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
HELPER_PATH="${SCRIPT_DIR}/lib/lifecycle-discovery.sh"
QUALIFIER_PATH="${REPOSITORY_ROOT}/vm/reference/qualify-bootstrap"

if [[ "$#" -eq 1 && "$1" == '--help' ]]; then
  # shellcheck disable=SC1090 # The helper path is resolved from BASH_SOURCE to support arbitrary working directories and paths with spaces.
  if [[ ! -f "$HELPER_PATH" ]] || ! source "$HELPER_PATH"; then
    printf '%s\n' \
      'MirrorOS: incomplete or damaged checkout; the lifecycle discovery helper could not be loaded.' \
      'Restore the helper from Git or re-clone the repository.' >&2
    exit 6
  fi

  lifecycle_discovery_print_help \
    'test' \
    'Qualify a Story 1.3 bootstrap bundle by booting its unchanged ISO headless in the fixed reference VM; this is not installation testing.' \
    'Run as a normal user with functional KVM, OVMF firmware, and qemu-system-x86_64, qemu-img, xorriso, node, gitleaks, git, and timeout.' \
    'Accepts exactly one bundle directory argument or a sole --help. The bundle needs the ISO, SHA256SUMS, artifact-metadata.json, and the package manifest.' \
    'Creates private run state under build/reference-vm/<run-id>/, launches one QEMU/KVM guest with a temporary NoCloud medium, and removes run resources after QEMU exit is confirmed.' \
    'Run-associated results, serial output, QEMU diagnostics, and scan reports are retained under evidence/reference-vm/<run-id>/.'
  exit 0
fi

if [[ ! -f "$QUALIFIER_PATH" || ! -r "$QUALIFIER_PATH" || ! -x "$QUALIFIER_PATH" ]] || \
  ! /usr/bin/bash -n "$QUALIFIER_PATH" >/dev/null 2>&1; then
  printf '%s\n' \
    'MirrorOS: incomplete or damaged checkout; the reference VM qualifier could not be loaded.' \
    'Restore vm/reference/qualify-bootstrap from Git or re-clone the repository.' >&2
  exit 6
fi

exec "$QUALIFIER_PATH" "$@"
