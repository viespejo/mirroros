#!/usr/bin/bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
HELPER_PATH="${SCRIPT_DIR}/lib/lifecycle-discovery.sh"

# shellcheck disable=SC1090 # The helper path is resolved from BASH_SOURCE to support arbitrary working directories and paths with spaces.
if [[ ! -f "$HELPER_PATH" ]] || ! source "$HELPER_PATH"; then
  printf '%s\n' \
    'MirrorOS: incomplete or damaged checkout; the lifecycle discovery helper could not be loaded.' \
    'Restore the helper from Git or re-clone the repository.' >&2
  exit 6
fi

if lifecycle_discovery_main \
  'test' \
  'Validate a MirrorOS artifact in the disposable reference VM; repository checks are not VM qualification.' \
  'A built artifact and a reference QEMU/KVM environment using UEFI/OVMF are anticipated; exact requirements are Pending.' \
  'The artifact and reference VM definition are expected inputs; their paths and selection details are Pending.' \
  'A future test may execute the artifact in a disposable VM and create test state and evidence; exact effects are Pending. The current command makes no changes.' \
  'Run-associated output belongs under evidence/; the exact path and format are Pending, and this command creates none.' \
  "$@"; then
  exit 0
else
  exit "$?"
fi
