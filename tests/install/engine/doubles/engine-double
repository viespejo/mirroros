#!/usr/bin/bash
# PATH double for the installation engine tests. One script serves every external tool of the engine (it is
# linked under each tool's name): it records the call, its environment, and its parent's command line, can be
# made to fail through fail.<tool>[.<subcommand>] files, and simulates just the effects the engine checks.
# It never touches a real device, mount, or account.
set -Eeuo pipefail
: "${DOUBLE_STATE:?}"
name="${0##*/}"
state="$DOUBLE_STATE"
root="${MIRROROS_DISCOVERY_ROOT:-}"
printf '%s %s\n' "$name" "$*" >> "${state}/calls.log"
printf '%s %s\n' "$name" "$(umask)" >> "${state}/umask.log"
{ tr '\0' '\n' < "/proc/$$/environ"; tr '\0' ' ' < "/proc/${PPID}/cmdline"; printf '\n'; } >> "${state}/observed.log" 2> /dev/null || true

subcommand=''
[[ "$name" == arch-chroot ]] && subcommand="${2:-}"
failure_keys=("fail.${name}")
[[ -z "$subcommand" ]] || failure_keys=("fail.${name}.${subcommand}" "fail.${name}")
for key in "${failure_keys[@]}"; do
  if [[ -f "${state}/${key}" ]]; then
    printf '%s: simulated failure\n' "$name" >&2
    exit "$(< "${state}/${key}")"
  fi
done

last="${*: -1}"
base="${last##*/}"
emit_output() {
  local file
  for file in "${state}/out/${name}.${base}" "${state}/out/${name}"; do
    if [[ -f "$file" ]]; then cat "$file"; return 0; fi
  done
  return 1
}

set_shadow() {
  local target="$1" account="$2" value="$3"
  awk -F: -v OFS=: -v account="$account" -v value="$value" '$1 == account { $2 = value } { print }' "${target}/etc/shadow" > "${target}/etc/shadow.new"
  mv -- "${target}/etc/shadow.new" "${target}/etc/shadow"
}

case "$name" in
  wipefs)
    if [[ " $* " == *' --noheadings '* ]]; then emit_output || true; fi
    ;;
  sfdisk)
    if [[ " $* " == *' --dump '* ]]; then emit_output || printf 'label: gpt\n'
    elif [[ " $* " == *' --part-type '* ]]; then
      emit_output || { [[ "$last" == 1 ]] && printf 'C12A7328-F81F-11D2-BA4B-00A0C93EC93B\n' || printf '0FC63DAF-8483-4772-8E79-3D69D8477DE4\n'; }
    else cat >> "${state}/sfdisk-input.log"
    fi
    ;;
  blockdev)
    if [[ " $* " == *' --getsize64 '* ]]; then emit_output || printf '2147483648\n'; fi
    ;;
  partprobe)
    touch "${1}1" "${1}2"
    ;;
  blkid)
    # The tag follows --match-tag (engine) or -s (checker); the device is the last argument.
    tag=''
    for ((index = 1; index < $#; index++)); do
      [[ "${!index}" == --match-tag || "${!index}" == -s ]] && { next=$((index + 1)); tag="${!next}"; }
    done
    node="$last"
    case "$tag" in
      UUID) if [[ "$node" == *1 ]]; then printf 'ABCD-1234\n'; else printf '11111111-2222-4333-8444-555555555555\n'; fi ;;
      TYPE)
        if [[ "$node" == *1 ]]; then printf 'vfat\n'
        elif grep -q '^mkfs.btrfs ' "${state}/calls.log"; then printf 'btrfs\n'
        else emit_output || printf 'ext4\n'; fi
        ;;
    esac
    ;;
  mount)
    printf '%s\n' "$last" >> "${state}/mounted.list"
    mount_options=''
    for ((index = 1; index < $#; index++)); do
      [[ "${!index}" == -o ]] && { next=$((index + 1)); mount_options="${!next}"; }
    done
    printf '%s\t%s\t%s\n' "$last" "${*: -2:1}" "$mount_options" >> "${state}/mounts.log"
    ;;
  umount)
    if [[ -f "${state}/mounted.list" ]]; then
      grep -v -- "^${last}" "${state}/mounted.list" > "${state}/mounted.new" || true
      mv -- "${state}/mounted.new" "${state}/mounted.list"
    fi
    if [[ -f "${state}/mounts.log" ]]; then
      if [[ " $* " == *' -R '* ]]; then
        awk -F'\t' -v target="$last" 'index($1, target) != 1' "${state}/mounts.log" > "${state}/mounts.new" || true
      else
        awk -F'\t' -v target="$last" '$1 != target' "${state}/mounts.log" > "${state}/mounts.new" || true
      fi
      mv -- "${state}/mounts.new" "${state}/mounts.log"
    fi
    ;;
  findmnt)
    # The raw TARGET SOURCE FSTYPE OPTIONS lines of the recorded mounts at or beneath the given target.
    [[ -f "${state}/mounts.log" ]] || exit 1
    found=1
    while IFS=$'\t' read -r mount_dir mount_device mount_options; do
      case "$mount_dir" in "$last" | "$last"/*) ;; *) continue ;; esac
      if [[ "$mount_device" == *1 ]]; then fstype=vfat
      elif grep -q '^mkfs.btrfs ' "${state}/calls.log"; then fstype=btrfs
      else fstype=ext4; fi
      options="rw,relatime${mount_options:+,${mount_options//subvol=@/subvol=/@}}"
      if [[ "$fstype" == vfat ]]; then options="${options//umask=0077/fmask=0077,dmask=0077}"; fi
      printf '%s %s %s %s\n' "${mount_dir// /\\x20}" "${mount_device// /\\x20}" "$fstype" "$options"
      found=0
    done < "${state}/mounts.log"
    exit "$found"
    ;;
  mountpoint)
    [[ -f "${state}/mounted.list" ]] && grep -qx -- "$last" "${state}/mounted.list"
    ;;
  genfstab)
    if grep -q '^mkfs.btrfs ' "${state}/calls.log"; then
      root_uuid=11111111-2222-4333-8444-555555555555
      printf 'UUID=%s / btrfs rw,relatime,compress=zstd:1,subvolid=256,subvol=/@ 0 0\n' "$root_uuid"
      printf 'UUID=%s /home btrfs rw,relatime,compress=zstd:1,subvolid=257,subvol=/@home 0 0\n' "$root_uuid"
      printf 'UUID=%s /var/log btrfs rw,relatime,compress=zstd:1,subvolid=258,subvol=/@log 0 0\n' "$root_uuid"
      printf 'UUID=%s /var/cache/pacman/pkg btrfs rw,relatime,compress=zstd:1,subvolid=259,subvol=/@pkg 0 0\n' "$root_uuid"
      printf 'UUID=%s /.snapshots btrfs rw,relatime,compress=zstd:1,subvolid=260,subvol=/@snapshots 0 0\n' "$root_uuid"
      if [[ -d "${last}/@swap" ]]; then
        printf 'UUID=%s /swap btrfs rw,relatime,compress=zstd:1,subvolid=261,subvol=/@swap 0 0\n' "$root_uuid"
      fi
    else
      printf 'UUID=11111111-2222-4333-8444-555555555555 / ext4 rw,relatime 0 1\n'
    fi
    printf 'UUID=ABCD-1234 /boot vfat rw,umask=0077 0 2\n'
    ;;
  btrfs)
    case "${1:-} ${2:-}" in
      'subvolume create') mkdir -p -- "${3}" ;;
      'subvolume list')
        for dir in "${3}"/@*; do
          if [[ -d "$dir" ]]; then printf 'ID 256 gen 7 top level 5 path %s\n' "${dir##*/}"; fi
        done
        ;;
      'subvolume delete') rm -rf -- "${3}" ;;
      'filesystem mkswapfile')
        size="${4}"
        truncate -s "${size%M}M" "${5}"
        chmod 600 "${5}"
        ;;
      'inspect-internal map-swapfile') emit_output || printf '1998848\n' ;;
    esac
    ;;
  mkswap)
    file="${2:-}"
    size="${4:-}"
    truncate -s "${size%M}M" "$file"
    chmod 600 "$file"
    ;;
  filefrag)
    emit_output || printf 'Filesystem type is: ef53\n ext logical physical expected length flags\n   0:        0..    1023:      34816..     35839:   1024: last,eof\n'
    ;;
  systemctl)
    if [[ "${1:-}" == is-active ]]; then
      if [[ -f "${state}/keyring-failed" ]]; then printf 'failed\n'; exit 3; fi
      if [[ -f "${state}/keyring-not-ready" ]]; then printf 'inactive\n'; exit 3; fi
      printf 'active\n'
    elif [[ "${1:-}" == --root=* && "${2:-}" == is-enabled ]]; then
      unit="${3:-}"
      unit="${unit%.service}"
      if [[ -f "${state}/enabled/${unit}" ]]; then printf 'enabled\n'; else printf 'disabled\n'; exit 1; fi
    fi
    ;;
  pacman)
    # pacman --root <target> --dbpath <path> -Q: the packages of the simulated local database.
    database=''
    for ((index = 1; index < $#; index++)); do
      [[ "${!index}" == --dbpath ]] && { next=$((index + 1)); database="${!next}"; }
    done
    for entry in "${database}/local"/*/; do
      [[ -d "$entry" ]] || continue
      entry="${entry%/}"
      entry="${entry##*/}"
      printf '%s %s\n' "${entry%-*-*}" "${entry##"${entry%-*-*}"-}"
    done
    ;;
  lsinitcpio)
    # The listing of an initramfs; the microcode entries follow the microcode packages of the simulated target.
    printf 'early_cpio\nkernel\nkernel/x86\nkernel/x86/microcode\n'
    target_dir="${last%/boot/*}"
    if [[ ! -f "${state}/initramfs-no-microcode" ]]; then
      compgen -G "${target_dir}/var/lib/pacman/local/amd-ucode-*" > /dev/null && printf 'kernel/x86/microcode/AuthenticAMD.bin\n'
      compgen -G "${target_dir}/var/lib/pacman/local/intel-ucode-*" > /dev/null && printf 'kernel/x86/microcode/GenuineIntel.bin\n'
    fi
    printf 'usr/lib/modules/6.1.0/kernel/fs/ext4/ext4.ko\n'
    ;;
  lsattr)
    printf -- '---------------C------ %s\n' "$last"
    ;;
  pacstrap)
    target="${2:-}"
    mkdir -p "${target}/boot" "${target}/etc/pacman.d" "${target}/etc/sudoers.d" "${target}/etc/sysctl.d" \
      "${target}/usr/share/zoneinfo/Europe" "${target}/var/lib/pacman/local" "${target}/var/tmp"
    if [[ -f "${state}/pacstrap-hang" ]]; then
      : > "${state}/pacstrap-started"
      while [[ ! -f "${state}/pacstrap-release" ]]; do /usr/bin/sleep 0.2; done
    fi
    printf 'kernel\n' > "${target}/boot/vmlinuz-linux"
    printf 'initramfs\n' > "${target}/boot/initramfs-linux.img"
    printf 'initramfs\n' > "${target}/boot/initramfs-linux-fallback.img"
    cp -- "${root}/etc/pacman.d/mirrorlist" "${target}/etc/pacman.d/mirrorlist"
    : > "${target}/usr/share/zoneinfo/Europe/Madrid"
    # The shipped file keeps two trailing blanks on every commented entry.
    printf '#en_US.UTF-8 UTF-8  \n#es_ES.UTF-8 UTF-8  \n#fr_FR.UTF-8 UTF-8  \n' > "${target}/etc/locale.gen"
    printf '[options]\n#Color\n#ParallelDownloads = 5\n#VerbosePkgLists\n\n[core]\nInclude = /etc/pacman.d/mirrorlist\n' > "${target}/etc/pacman.conf"
    printf 'root:x:0:0::/root:/usr/bin/bash\n' > "${target}/etc/passwd"
    printf 'root::19000:0:99999:7:::\n' > "${target}/etc/shadow"
    printf 'root:x:0:\nwheel:x:998:\n' > "${target}/etc/group"
    count=0
    for package in "${@:3}"; do count=$((count + 1)); mkdir -p "${target}/var/lib/pacman/local/${package}-1-1"; done
    ;;
  arch-chroot)
    target="${1:-}"
    command_name="${2:-}"
    case "$command_name" in
      pacman) printf 'base 3-1\nlinux 6.1-1\n' ;;
      useradd)
        arguments=("${@:3}")
        account="${arguments[${#arguments[@]}-1]}"
        groups=''
        shell=''
        for ((index = 0; index < ${#arguments[@]}; index++)); do
          [[ "${arguments[index]}" == --groups ]] && groups="${arguments[index + 1]}"
          [[ "${arguments[index]}" == --shell ]] && shell="${arguments[index + 1]}"
        done
        printf '%s:x:1000:1000::/home/%s:%s\n' "$account" "$account" "$shell" >> "${target}/etc/passwd"
        printf '%s:!:19000:0:99999:7:::\n' "$account" >> "${target}/etc/shadow"
        for group in ${groups//,/ }; do
          awk -F: -v OFS=: -v group="$group" -v account="$account" '$1 == group { $4 = ($4 == "" ? account : $4 "," account) } { print }' "${target}/etc/group" > "${target}/etc/group.new"
          mv -- "${target}/etc/group.new" "${target}/etc/group"
        done
        ;;
      chpasswd)
        input="$(cat)"
        printf '%s\n' "$input" >> "${state}/chroot-stdin.log"
        # shellcheck disable=SC2016 # The simulated shadow hash requires literal dollar separators.
        set_shadow "$target" "${input%%:*}" '$6$simulated$hash'
        ;;
      passwd) set_shadow "$target" root '!' ;;
      snapper)
        case "${6:-}" in
          create-config)
            mkdir -p "${target}/.snapshots" "${target}/etc/snapper/configs"
            printf 'TIMELINE_CREATE="yes"\nNUMBER_CLEANUP="no"\nNUMBER_LIMIT="50"\n' > "${target}/etc/snapper/configs/root"
            ;;
          set-config)
            for setting in "${@:7}"; do
              key="${setting%%=*}"
              grep -v "^${key}=" "${target}/etc/snapper/configs/root" > "${target}/etc/snapper/configs/root.new" || true
              printf '%s="%s"\n' "$key" "${setting#*=}" >> "${target}/etc/snapper/configs/root.new"
              mv -- "${target}/etc/snapper/configs/root.new" "${target}/etc/snapper/configs/root"
            done
            ;;
          create) printf '%s\n' "$last" >> "${state}/snapshots.list" ;;
          list)
            printf ' # | Type | Description\n---+------+------------\n0  | single | current\n'
            if [[ -f "${state}/snapshots.list" ]]; then
              while IFS= read -r description; do printf '1  | single | %s\n' "$description"; done < "${state}/snapshots.list"
            fi
            ;;
        esac
        ;;
      env)
        # env SNAP_PAC_SKIP=y pacman -U --noconfirm <packages>: the transaction of the pinned Limine tools. It
        # writes what the real one was observed to write (docs: development check of Story 2.5, DEC-021).
        [[ "${3:-}" == SNAP_PAC_SKIP=y && "${4:-}" == pacman && "${5:-}" == -U ]] || exit 0
        [[ -f "${target}/etc/mkinitcpio.conf.d/10-mirroros-limine.conf" ]] || { printf 'the HOOKS drop-in is missing\n' >&2; exit 1; }
        for package in "${@:7}"; do
          [[ -f "${target}${package}" ]] || { printf 'package %s is missing\n' "$package" >&2; exit 1; }
        done
        : > "${state}/limine-installed"
        machine=602fb108992848dfa504d317934f9444
        mkdir -p "${target}/boot/${machine}/linux" "${target}/boot/EFI/BOOT"
        [[ -f "${state}/limine-no-efi" ]] || printf 'EFI\n' > "${target}/boot/EFI/BOOT/BOOTX64.EFI"
        [[ -f "${state}/limine-missing-kernel" ]] || printf 'kernel\n' > "${target}/boot/${machine}/linux/vmlinuz"
        printf 'initramfs\n' > "${target}/boot/${machine}/linux/initramfs"
        if [[ -f "${state}/limine-uki" ]]; then
          mkdir -p "${target}/boot/EFI/Linux"
          printf 'uki\n' > "${target}/boot/EFI/Linux/mirroros.efi"
        fi
        cmdline="$(sed -n 's/^KERNEL_CMDLINE\[default\]="\(.*\)"$/\1/p' "${target}/etc/default/limine")"
        timeout=3
        [[ ! -f "${state}/limine-timeout" ]] || timeout="$(< "${state}/limine-timeout")"
        {
          printf '### Auto-generated by limine-entry-tool\ntimeout: %s\ndefault_entry: 2\n \n \n' "$timeout"
          if [[ ! -f "${state}/limine-no-entry" ]]; then
            printf '/+Arch Linux\ncomment: machine-id=%s order-priority=50 \n  //linux\n  protocol: linux\n' "$machine"
            printf '  module_path: boot():/%s/linux/initramfs#0123abcd\n  path: boot():/%s/linux/vmlinuz#4567ef01\n' "$machine" "$machine"
            printf '  cmdline: %s\n' "$cmdline"
          fi
        } > "${target}/boot/limine.conf"
        ;;
      limine-snapper-sync)
        [[ -f "${state}/limine-installed" ]] || { printf 'limine-snapper-sync: command not found\n' >&2; exit 127; }
        [[ ! -f "${state}/limine-no-snapshot-entry" ]] || exit 0
        machine=602fb108992848dfa504d317934f9444
        history="${target}/boot/${machine}/limine_history"
        mkdir -p "$history"
        printf 'kernel\n' > "${history}/vmlinuz_sha256_0123"
        [[ -f "${state}/limine-missing-snapshot-file" ]] || printf 'initramfs\n' > "${history}/initramfs_sha256_0123"
        cmdline="$(sed -n 's/^  cmdline: //p' "${target}/boot/limine.conf" | head -n 1)"
        {
          printf '\n     //Snapshots\n     comment: 1 snapshots\n     ///1 | 2026-10-12 21:25:57\n     comment: post-install baseline\n     ////linux\n     protocol: linux\n'
          printf '     module_path: boot():/%s/limine_history/initramfs_sha256_0123#0123abcd\n' "$machine"
          printf '     path: boot():/%s/limine_history/vmlinuz_sha256_0123#4567ef01\n' "$machine"
          printf '     cmdline: %s\n' "${cmdline//rootflags=subvol=@/rootflags=subvol=/@snapshots/1/snapshot}"
        } >> "${target}/boot/limine.conf"
        ;;
      bootctl)
        if [[ "${3:-}" == install ]]; then
          mkdir -p "${target}/boot/EFI/systemd" "${target}/boot/EFI/BOOT" "${target}/boot/loader/entries"
          printf 'EFI\n' > "${target}/boot/EFI/systemd/systemd-bootx64.efi"
          printf 'EFI\n' > "${target}/boot/EFI/BOOT/BOOTX64.EFI"
        fi
        ;;
      systemctl)
        mkdir -p "${state}/enabled"
        if [[ "${3:-}" == enable ]]; then
          : > "${state}/enabled/${4}"
          [[ ! -f "${state}/postconditions-missing-kernel" ]] || rm -f -- "${target}/boot/vmlinuz-linux"
        elif [[ "${3:-}" == disable ]]; then rm -f -- "${state}/enabled/${4}"
        elif [[ "${3:-}" == is-enabled ]]; then [[ -f "${state}/enabled/${4}" ]] && printf 'enabled\n'
        fi
        ;;
    esac
    ;;
  *) ;;
esac
