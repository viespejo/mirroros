#!/usr/bin/bash
set -Eeuo pipefail
name=${0##*/}
printf '%s %s\n' "$name" "$*" >> "$CFG_TEST_CALLS"
case "$name" in
  wpctl)
    [[ "${HW_AUDIO_UNAVAILABLE:-0}" == 0 ]] || exit 1
    if [[ "$1" == set-mute && "$2" == @DEFAULT_AUDIO_SOURCE@ ]]; then
      : > "$CFG_TEST_DIR/mic-toggled"
    elif [[ "$1" == get-volume ]]; then
      if [[ "$2" == @DEFAULT_AUDIO_SOURCE@ && -e "$CFG_TEST_DIR/mic-toggled" ]]; then
        case "${HW_MIC_RESULT:-unmuted}" in
          muted) printf 'Volume: 0.50 [MUTED]\n' ;;
          unmuted) printf 'Volume: 0.50\n' ;;
          unavailable) exit 1 ;;
          invalid) printf 'Unknown microphone state\n' ;;
        esac
      else
        printf 'Volume: 0.50\n'
      fi
    fi ;;
  brightnessctl)
    [[ "${HW_BRIGHTNESS_UNAVAILABLE:-0}" == 0 ]] || exit 1
    printf '50\n' ;;
  playerctl) [[ "${HW_MEDIA_UNAVAILABLE:-0}" == 0 ]] || exit 1 ;;
  qs)
    if [[ "${4:-}" == call && "${5:-}" != -- && "${6:-}" == show ]]; then
      printf 'show: The following argument was not expected\n' >&2
      exit 109
    fi
    [[ "${HW_OSD_UNAVAILABLE:-0}" == 0 ]] || exit 1 ;;
  notify-send) [[ "${HW_NOTIFY_FAIL:-0}" == 0 ]] || exit 1 ;;
  bluetoothctl) exit 0 ;;
  nmcli)
    [[ "$*" == '--offline connection add type vpn vpn-type openconnect con-name mirroros-plugin-check' ]] || exit 97
    [[ "${HW_PLUGIN_FAIL:-0}" == 0 ]] || exit 1 ;;
  upower) [[ "${HW_MONITOR_FAIL:-0}" == 0 ]] || exit 17 ;;
  *) exit 97 ;;
esac
