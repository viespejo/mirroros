#!/usr/bin/bash
set -Eeuo pipefail
# Only the streamed postcondition scripts need filesystem translation into the fake root.
if [[ "${1:-}" == -s ]]; then
  script=$(</dev/stdin)
  script=${script//\/usr\/lib\//$HW_TEST_ROOT/usr/lib/}
  script=${script//\/sys\/class\//$HW_TEST_ROOT/sys/class/}
  script=${script//\/etc\/pam.d\//$HW_TEST_ROOT/etc/pam.d/}
  # Only quoted command paths: the literal PAM gate line in the fingerprint check must stay untranslated.
  script=${script//\"\/usr\/share\/mirroros\/hardware\//\"$HW_TEST_ROOT/usr/share/mirroros/hardware/}
  exec /usr/bin/bash "$@" <<< "$script"
fi
exec /usr/bin/bash "$@"
