#!/usr/bin/bash
set -Eeuo pipefail
root=$1
shift
printf 'arch-chroot %s %s\n' "$root" "$*" >> "$CFG_TEST_CALLS"
# Keep tool failures inside the fake target, independent of the host's installed tools.
if [[ "$1" == bash && "${2:-}" == -c && "$3" == command\ -v* ]]; then
  tool="${5:-pacman}"
  [[ " ${CFG_TEST_MISSING_TOOLS:-} " != *" $tool "* ]] || exit 127
  printf '/usr/bin/%s\n' "$tool"
  exit 0
fi
# Streamed hardware postconditions inspect only the fake target's plugin paths.
if [[ "$1" == bash && "${2:-}" == -s ]]; then
  script=$(</dev/stdin)
  script=${script//\/usr\/lib\//$root/usr/lib/}
  exec bash "${@:2}" <<< "$script"
fi
if [[ "$1" == runuser ]]; then
  home=$(awk -F: -v user="$3" '$1 == user { print $6 }' "$root/etc/passwd")
  [[ "$home" == /* ]] || exit 97
  export CFG_TEST_HOME="$root$home"
fi
if [[ "$1" == usermod ]]; then export CFG_TEST_PASSWD_ROOT="$root"; fi
if [[ "$1" == timeout ]]; then
  shift
  exec "$CFG_TEST_DIR/bin/network-tool" timeout "$@"
fi
if [[ "$1" == systemctl && "${*: -1}" == systemd-resolved.service ]]; then
  shift
  exec "$CFG_TEST_DIR/bin/network-tool" systemctl "$@"
fi
if [[ "$1" == systemctl ]]; then
  shift
  case "$1" in
    is-enabled)
      case "${*: -1}" in
        sddm.service) [[ -e "$root/etc/systemd/system/.sddm-enabled" ]] ;;
        bluetooth.service|power-profiles-daemon.service) [[ -e "$root/etc/systemd/system/.${*: -1}-enabled" ]] ;;
        *) exit 97 ;;
      esac ;;
    enable)
      mkdir -p "$root/etc/systemd/system"
      case "$2" in
        sddm.service)
          : > "$root/etc/systemd/system/.sddm-enabled"
          ln -s /usr/lib/systemd/system/sddm.service "$root/etc/systemd/system/display-manager.service" ;;
        bluetooth.service|power-profiles-daemon.service) : > "$root/etc/systemd/system/.$2-enabled" ;;
        *) exit 97 ;;
      esac ;;
    get-default) if [[ -f "$root/etc/systemd/system/.default-target" ]]; then
        cat "$root/etc/systemd/system/.default-target"
      else printf 'multi-user.target\n'; fi ;;
    set-default) printf '%s\n' "$2" > "$root/etc/systemd/system/.default-target" ;;
    list-unit-files) if [[ -e "$root/etc/systemd/system/.sddm-enabled" ]]; then printf 'sddm.service enabled\n'; fi ;;
    cat) printf '[Install]\nAlias=display-manager.service\n' ;;
    *) printf 'Unexpected systemctl command: %s\n' "$*" >&2; exit 97 ;;
  esac
  exit $?
fi
exec "$@"
