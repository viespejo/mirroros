#!/usr/bin/bash
# Rewrites the normal cmdline: lines of limine.conf from /etc/default/limine and rebuilds the referenced initramfs;
# snapshot entries below //Snapshots are kept byte for byte, like the installed tool.
set -Eeuo pipefail
printf 'limine-update%s\n' "${*:+ $*}" >> "$CFG_TEST_CALLS"
root="${CFG_TEST_TARGET_ROOT:-${MIRROROS_CONFIGURE_ROOT:-}}"
# The installed limine-update reports success even when its rebuild step is missing.
[[ "${CFG_TEST_LIMINE_SILENT_FAIL:-0}" != 1 ]] || { printf 'ERROR: limine-mkinitcpio not found.\n' >&2; exit 0; }
cmdline="$(sed -n 's/^KERNEL_CMDLINE\[default\]="\(.*\)"$/\1/p' "$root/etc/default/limine")"
snapshots=0
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ "$line" != //Snapshots ]] || snapshots=1
  if (( ! snapshots )) && [[ "$line" =~ ^([[:space:]]*cmdline:[[:space:]]*) ]]; then line="${BASH_REMATCH[1]}$cmdline"; fi
  if (( ! snapshots )) && [[ "$line" =~ module_path:[[:space:]]*boot\(\):(/[^[:space:]]+) ]]; then
    initramfs-fixture "$root" "/boot${BASH_REMATCH[1]}"
  fi
  printf '%s\n' "$line"
done < "$root/boot/limine.conf" > "$root/boot/limine.conf.new"
mv -- "$root/boot/limine.conf.new" "$root/boot/limine.conf"
