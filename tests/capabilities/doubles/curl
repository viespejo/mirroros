  fixture="$(mktemp -d)"
  mkdir -p "$fixture/google-cloud-sdk/bin"
  printf '%s\n' "${CFG_TEST_GCLOUD_VERSION:-589.0.0}" > "$fixture/google-cloud-sdk/VERSION"
  cat > "$fixture/google-cloud-sdk/bin/gcloud" <<'GCLOUD'
