    --output) output=$2; shift 2 ;;
    --connect-timeout|--max-time) shift 2 ;;
    --proto) [[ "$2" == '=https' ]] || exit 97; shift 2 ;;
    --tlsv1.2|--fail|--silent|--show-error|--location) shift ;;
