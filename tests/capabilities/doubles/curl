  if [[ ${CFG_TEST_CURL_FAIL:-0} == 1 ]]; then printf 'fixture download failure\n' >&2; exit 22; fi
  if [[ ${CFG_TEST_GCLOUD_CONCURRENT:-0} == 1 ]]; then
    mkdir -p "$CFG_TEST_HOME/.local/opt/google-cloud-sdk-589.0.0"
    printf 'concurrent content\n' > "$CFG_TEST_HOME/.local/opt/google-cloud-sdk-589.0.0/untouched"
