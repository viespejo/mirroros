#!/usr/bin/bash
set -Eeuo pipefail
printf 'npm %s\n' "$*" >> "${CFG_TEST_CALLS:?}"
printf 'npm-cwd %s\n' "$PWD" >> "$CFG_TEST_CALLS"
home=${CFG_TEST_HOME:?}
# Only the three reviewed invocations exist, and only below the fixture home.
case "${1:-}" in
  view)
    [[ "$*" == 'view @earendil-works/pi-coding-agent versions --json' ]] || exit 97
    if [[ ${CFG_TEST_NPM_VIEW_FAIL:-0} == 1 ]]; then printf 'fixture registry failure\n' >&2; exit 17; fi
    printf '%s\n' "${CFG_TEST_NPM_VERSIONS:-[\"1.2.0\",\"1.3.0\",\"1.4.0-beta.1\"]}" ;;
  install)
    if [[ "$2" == --prefix ]]; then
      # Initialize-only Pi packages: only below the staged agent directory, isolated from any user configuration.
      [[ "$3" == "$home"/.pi.mirroros.*/agent/npm && "$4" == --ignore-scripts && "$5" == --legacy-peer-deps &&
        "$6" == --no-audit && "$7" == --no-fund && $# -ge 8 ]] || exit 97
      work=${3%/agent/npm}/.work
      [[ "$HOME" == "$work/home" && "$NPM_CONFIG_USERCONFIG" == "$work/npmrc-user" &&
        "$NPM_CONFIG_GLOBALCONFIG" == "$work/npmrc-global" && -f "$NPM_CONFIG_USERCONFIG" && ! -s "$NPM_CONFIG_USERCONFIG" &&
        -f "$NPM_CONFIG_GLOBALCONFIG" && ! -s "$NPM_CONFIG_GLOBALCONFIG" &&
        "$NPM_CONFIG_CACHE" == "$work/cache" && "$NPM_CONFIG_IGNORE_SCRIPTS" == true ]] || exit 97
      printf 'npm-isolation %s %s\n' "${3##*/.pi.mirroros.}" "$NPM_CONFIG_IGNORE_SCRIPTS" >> "$CFG_TEST_CALLS"
      if [[ ${CFG_TEST_NPM_PACKAGES_FAIL:-0} == 1 ]]; then printf 'fixture packages failure\n' >&2; exit 17; fi
      for spec in "${@:8}"; do
        name=${spec%@*}
        [[ " ${CFG_TEST_NPM_PACKAGE_SKIP:-} " != *" $name "* ]] || continue
        mkdir -p "$3/node_modules/$name/bin"
        printf '{"name":"%s","version":"%s"}\n' "$name" "${spec##*@}" > "$3/node_modules/$name/package.json"
        printf '#!/usr/bin/bash\n' > "$3/node_modules/$name/bin/run"
        chmod 0755 "$3/node_modules/$name/bin/run"
      done
      exit 0
    fi
    [[ "$2" == --global && "$3" == --prefix && "$5" == --ignore-scripts && "$6" == --no-audit && "$7" == --no-fund &&
      "$8" == @earendil-works/pi-coding-agent@* && $# -eq 8 ]] || exit 97
    prefix=$4
    [[ "$prefix" == "$home"/.nvm/versions/node/v24.22.0 ]] || exit 97
    if [[ ${CFG_TEST_NPM_INSTALL_FAIL:-0} == 1 ]]; then printf 'fixture install failure\n' >&2; exit 17; fi
    version=${8#@earendil-works/pi-coding-agent@}
    mkdir -p "$prefix/lib/node_modules/@earendil-works/pi-coding-agent" "$prefix/bin"
    printf '{"name":"@earendil-works/pi-coding-agent","version":"%s"}\n' "$version" \
      > "$prefix/lib/node_modules/@earendil-works/pi-coding-agent/package.json"
    printf '#!/usr/bin/bash\nprintf "pi %s\\n"\n' "$version" > "$prefix/bin/pi"
    chmod 0755 "$prefix/bin/pi" ;;
  ci)
    [[ "$*" == 'ci --ignore-scripts --omit=dev --omit=peer --no-audit --no-fund' && "$PWD" == "$home/code/pi-config" ]] || exit 97
    if [[ ${CFG_TEST_NPM_CI_FAIL:-0} == 1 ]]; then printf 'fixture ci failure\n' >&2; exit 17; fi
    mkdir -p node_modules ;;
  *) exit 97 ;;
esac
