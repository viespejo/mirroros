#!/usr/bin/bash
set -Eeuo pipefail
printf 'pacman %s\n' "$*" >> "$CFG_TEST_CALLS"
mode="$1"
shift
case "$mode" in
  -Sp)
    package="${!#}"
    name="${package#*/}"
    repository="${package%%/*}"
    [[ "${CFG_TEST_PACKAGE_ABSENT:-0}" != 1 ]] || exit 1
    printf '%s %s 1.0-1\n' "${CFG_TEST_REPOSITORY:-$repository}" "$name" ;;
  -Q)
    name="${!#}"
    [[ -e "$CFG_TEST_INSTALLED/$name" || "${CFG_TEST_ALL_INSTALLED:-0}" == 1 ]] || exit 1
    # A locally installed package keeps the version of its file; official fixtures are always 1.0-1.
    version="$(cat -- "$CFG_TEST_INSTALLED/$name" 2> /dev/null || true)"
    printf '%s %s\n' "$name" "${version:-1.0-1}" ;;
  -Qu)
    printf '%s' "${CFG_TEST_UPGRADES:-}"
    exit "${CFG_TEST_QUERY_STATUS:-0}" ;;
  -S|-Syu)
    [[ "${CFG_TEST_INSTALL_FAIL:-0}" != 1 ]] || exit 17
    for package in "$@"; do
      [[ "$package" != -* ]] || continue
      : > "$CFG_TEST_INSTALLED/${package#*/}"
    done ;;
  -U)
    [[ "${CFG_TEST_INSTALL_FAIL:-0}" != 1 ]] || exit 17
    file="$(basename -- "${!#}")"
    [[ "$file" =~ ^(.+)-([0-9][^-]*-[0-9.]+)-[^-]+\.pkg\.tar\.zst$ ]] || exit 97
    printf '%s\n' "${BASH_REMATCH[2]}" > "$CFG_TEST_INSTALLED/${BASH_REMATCH[1]}" ;;
  *) printf 'Unexpected pacman mode: %s\n' "$mode" >&2; exit 97 ;;
esac
