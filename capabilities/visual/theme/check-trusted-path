#!/usr/bin/bash
# managed by MirrorOS configure
# Check a product file below a caller-supplied trusted anchor, without executing it.
# Usage: check-trusted-path <anchor> <relative-path> <owner-uid> [file|directory]
# The caller must establish trust in every ancestor above the anchor. For a running
# system use / as the anchor and the system owner UID. This is a point-in-time
# check, not protection against concurrent privileged changes.
set -Eeuo pipefail
export LC_ALL=C

(( $# == 3 || $# == 4 )) || { printf 'Usage: check-trusted-path <anchor> <relative-path> <owner-uid> [file|directory]\n' >&2; exit 6; }
anchor="$1" relative="$2" uid="$3" final_type="${4:-file}"
[[ "$final_type" == file || "$final_type" == directory ]] || exit 6
[[ "$anchor" == /* && "$relative" =~ ^[a-zA-Z0-9._/-]+$ && "$uid" =~ ^[0-9]+$ ]] || exit 6
[[ "$relative" != /* && "$relative" != */ && "/$relative/" != *'//'* && "/$relative/" != *'/./'* && "/$relative/" != *'/../'* ]] || exit 6

check_entry() {
  local path="$1" type="$2" owner mode
  [[ ! -L "$path" ]] || return 1
  if [[ "$type" == directory ]]; then [[ -d "$path" ]] || return 1; else [[ -f "$path" ]] || return 1; fi
  read -r owner mode < <(stat -c '%u %a' -- "$path")
  [[ "$owner" == "$uid" && "$mode" =~ ^[0-7]+$ ]] || return 1
  (( (8#$mode & 8#022) == 0 ))
}

# The anchor itself must be canonical so that no symlink is hidden within it.
[[ "$(realpath -e -- "$anchor")" == "$anchor" ]] || exit 4
check_entry "$anchor" directory || { printf 'Untrusted anchor: %s\n' "$anchor" >&2; exit 4; }
path="${anchor%/}"
IFS=/ read -r -a parts <<< "$relative"
for (( i=0; i<${#parts[@]}; i++ )); do
  path="$path/${parts[i]}"
  type=directory
  (( i == ${#parts[@]} - 1 )) && type="$final_type"
  check_entry "$path" "$type" || { printf 'Untrusted or missing theme path: %s\n' "$path" >&2; exit 4; }
done
