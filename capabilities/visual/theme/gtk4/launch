#!/usr/bin/bash
# Launch reviewed native GTK4 consumers without changing user preferences or session settings.
set -Eeuo pipefail

usage() { printf 'Usage: %s pavucontrol|gtk4-widget-factory [application arguments...]\n' "$0"; }
if [[ "${1:-}" == --help && $# == 1 ]]; then usage; exit 0; fi
case "${1:-}" in
  pavucontrol) app=/usr/bin/pavucontrol ;;
  gtk4-widget-factory) app=/usr/bin/gtk4-widget-factory ;;
  *) usage >&2; exit 2 ;;
esac
shift
readonly theme_root=/usr/share/mirroros/themes runtime=/usr/share/mirroros/themes/gtk4

unavailable() { printf 'GTK4 theme unavailable: %s; rerun MirrorOS configure.\n' "$1" >&2; exit 4; }
# Establish trust before executing the resolver; no user-controlled theme code is loaded.
for path in / /usr /usr/share /usr/share/mirroros "$theme_root" "$runtime" "$theme_root/default" \
  "$theme_root/resolve-current" "$theme_root/check-trusted-path"; do
  [[ ! -L "$path" && ( -d "$path" || -f "$path" ) ]] || unavailable "$path"
  read -r owner mode < <(stat -c '%u %a' -- "$path")
  [[ "$owner" == 0 && "$mode" =~ ^[0-7]+$ ]] || unavailable "$path"
  (( (8#$mode & 8#022) == 0 )) || unavailable "$path"
done
# CSS imports and icon lookup may descend into this tree; reject links and unsafe entries throughout it.
unsafe="$(find "$runtime" \( ! -uid 0 -o -perm /022 -o \( ! -type f -a ! -type d \) \) -print -quit)" || unavailable "$runtime"
[[ -z "$unsafe" ]] || unavailable "$unsafe"
for relative in base.css control-states.css focus-states.css chrome.css apps/pavucontrol.css \
  share/themes/MirrorOS/gtk-4.0/gtk.css; do
  [[ -f "$runtime/$relative" ]] || unavailable "$runtime/$relative"
done
state="${XDG_STATE_HOME:-$HOME/.local/state}"
selected="$(bash "$theme_root/resolve-current" / "$state" 0 gtk4)" || exit 4
[[ "$selected" == "$theme_root/default/gtk-4.0.css" ]] || unavailable 'unsupported palette'
[[ -x "$app" ]] || { printf 'GTK4 application unavailable: %s\n' "$app" >&2; exit 4; }
exec env GTK_THEME=MirrorOS XDG_DATA_DIRS="$runtime/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" "$app" "$@"
