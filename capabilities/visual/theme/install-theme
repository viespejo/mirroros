#!/usr/bin/bash
# Publish the reviewed theme as one manifest-checked tree. No user files are managed here.
# check <source> <destination> <uid> <gid>: 0 current, 1 absent or update needed, 4 conflict.
# publish <source> <destination> <uid> <gid>: stage and atomically exchange an intact delivery.
set -Eeuo pipefail
export LC_ALL=C

manifest=.mirroros-manifest
usage() { printf 'Usage: install-theme check|publish <source> <destination> <uid> <gid>\n' >&2; exit 6; }

safe_names() {
  local root="$1" path
  while IFS= read -r -d '' path; do
    [[ "$path" =~ ^\./[a-zA-Z0-9._/-]+$ ]] || {
      printf 'Unsupported theme path: %q\n' "$path" >&2; return 6;
    }
  done < <(cd -- "$root" && find . -mindepth 1 -print0)
}

source_manifest() {
  local source="$1" kind mode path
  safe_names "$source" || return $?
  ( cd -- "$source" && find . -mindepth 1 -printf '%y %m %p\n' ) | sort -k3 | while read -r kind mode path; do
    case "$kind" in
      d) printf 'd 755 - %s\n' "$path" ;;
      f)
        [[ "$path" != "./$manifest" ]] || { printf 'Reserved source entry: %s\n' "$path" >&2; return 6; }
        (( 8#$mode & 8#111 )) && mode=755 || mode=644
        printf 'f %s %s %s\n' "$mode" "$(sha256sum < "$source/$path" | cut -d' ' -f1)" "$path" ;;
      *) printf 'Unsupported source entry: %s\n' "$path" >&2; return 6 ;;
    esac
  done
}

tree_manifest() {
  local dest="$1" kind mode path
  ( cd -- "$dest" && find . -mindepth 1 ! -path "./$manifest" -printf '%y %m %p\n' ) | sort -k3 |
    while read -r kind mode path; do
      case "$kind" in
        d) printf 'd %s - %s\n' "$mode" "$path" ;;
        f) printf 'f %s %s %s\n' "$mode" "$(sha256sum < "$dest/$path" | cut -d' ' -f1)" "$path" ;;
        *) printf '%s %s - %s\n' "$kind" "$mode" "$path" ;;
      esac
    done
}

check() {
  local source="$1" dest="$2" uid="$3" gid="$4" actual wanted
  [[ -e "$dest" || -L "$dest" ]] || return 1
  if [[ -L "$dest" || ! -d "$dest" || ! -f "$dest/$manifest" || -L "$dest/$manifest" ]] ||
    [[ "$(stat -c '%a:%u:%g' -- "$dest")" != "755:$uid:$gid" ]] ||
    [[ "$(stat -c '%a:%u:%g' -- "$dest/$manifest")" != "644:$uid:$gid" ]] ||
    [[ -n "$(find "$dest" -mindepth 1 \( ! -uid "$uid" -o ! -gid "$gid" \) -print -quit)" ]]; then
    printf 'Conflict: %s is not an intact MirrorOS theme delivery.\n' "$dest" >&2
    return 4
  fi
  if ! safe_names "$dest"; then
    printf 'Conflict: %s contains an unsupported path.\n' "$dest" >&2
    return 4
  fi
  actual="$(tree_manifest "$dest" | sort -k4)"
  if [[ "$actual" != "$(sort -k4 < "$dest/$manifest")" ]]; then
    printf 'Conflict: %s differs from its last MirrorOS delivery.\n' "$dest" >&2
    return 4
  fi
  wanted="$(source_manifest "$source" | sort -k4)"
  [[ "$actual" == "$wanted" ]] || return 1
}

publish() {
  local source="$1" dest="$2" uid="$3" gid="$4" status=0 parent staging kind mode path
  check "$source" "$dest" "$uid" "$gid" || status=$?
  case "$status" in 0) return 0 ;; 1) ;; *) return "$status" ;; esac
  parent="$(dirname -- "$dest")"
  install -d -m 0755 -- "$parent"
  staging="$(mktemp -d "$parent/.theme.mirroros-staging.XXXXXX")"
  # Only remove the directory created by this invocation, never other staging paths.
  trap '[[ -z "${staging:-}" ]] || rm -rf -- "$staging"' EXIT
  chmod 0755 "$staging"
  chown "$uid:$gid" "$staging"
  source_manifest "$source" > "$staging/$manifest"
  while read -r kind mode _ path; do
    if [[ "$kind" == d ]]; then
      install -d -m 0755 -o "$uid" -g "$gid" -- "$staging/$path"
    else
      install -m "0$mode" -o "$uid" -g "$gid" -- "$source/$path" "$staging/$path"
    fi
  done < "$staging/$manifest"
  chmod 0644 "$staging/$manifest"
  chown "$uid:$gid" "$staging/$manifest"
  [[ "$(tree_manifest "$staging" | sort -k4)" == "$(sort -k4 < "$staging/$manifest")" ]] || {
    printf 'Staged theme does not match its manifest.\n' >&2; return 5;
  }
  # Recheck before replacement; a conflicting delivery is never intentionally replaced.
  status=0
  check "$source" "$dest" "$uid" "$gid" || status=$?
  case "$status" in 0) return 0 ;; 1) ;; *) return "$status" ;; esac
  if [[ -e "$dest" ]]; then
    mv --exchange -T -- "$staging" "$dest"
    rm -rf -- "$staging"
  else
    mv -T --no-clobber -- "$staging" "$dest"
    if [[ -d "$staging" ]]; then
      printf 'Conflict: %s appeared during publication.\n' "$dest" >&2
      return 4
    fi
  fi
  staging=''
  check "$source" "$dest" "$uid" "$gid"
}

(( $# == 5 )) || usage
[[ -d "$2" && ! -L "$2" && "$4" =~ ^[0-9]+$ && "$5" =~ ^[0-9]+$ ]] || usage
case "$1" in
  check) check "$2" "$3" "$4" "$5" ;;
  publish) publish "$2" "$3" "$4" "$5" ;;
  *) usage ;;
esac
