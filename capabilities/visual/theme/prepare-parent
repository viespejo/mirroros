#!/usr/bin/bash
# Prepare reviewed product directories below the configure root.
# The caller is responsible for the configure root and its ancestors.
set -Eeuo pipefail

(( $# == 3 || $# == 4 )) || { printf 'Usage: prepare-parent <configure-root> <uid> <gid> [themes|foot|mirroros|system-themes|system-icons]\n' >&2; exit 6; }
root="$1" uid="$2" gid="$3" leaf="${4:-themes}"
[[ "$root" == /* && "$uid" =~ ^[0-9]+$ && "$gid" =~ ^[0-9]+$ && ( "$leaf" == themes || "$leaf" == foot || "$leaf" == mirroros || "$leaf" == system-themes || "$leaf" == system-icons ) ]] || exit 6
[[ "$root" == / ]] || root="${root%/}"
checker="$(dirname -- "${BASH_SOURCE[0]}")/check-trusted-path"
[[ "$(realpath -e -- "$root")" == "$root" ]] || { printf 'Untrusted configure root: %s\n' "$root" >&2; exit 4; }
# Check the root using the same owner and write-permission policy as its children.
root_mode="$(stat -c '%a' -- "$root")"
[[ ! -L "$root" && -d "$root" && "$(stat -c '%u' -- "$root")" == "$uid" && "$root_mode" =~ ^[0-7]+$ ]] || exit 4
(( (8#$root_mode & 8#022) == 0 )) || { printf 'Untrusted configure root permissions: %s\n' "$root" >&2; exit 4; }

relative=''
components=(usr share mirroros)
# system-themes is the shared native GTK theme lookup directory, /usr/share/themes.
[[ "$leaf" != system-themes ]] || components=(usr share themes)
# system-icons is the shared native icon theme lookup directory, /usr/share/icons.
[[ "$leaf" != system-icons ]] || components=(usr share icons)
[[ "$leaf" == mirroros || "$leaf" == system-themes || "$leaf" == system-icons ]] || components+=("$leaf")
for component in "${components[@]}"; do
  relative="${relative:+$relative/}$component"
  path="${root%/}/$relative"
  if [[ ! -e "$path" && ! -L "$path" ]]; then
    mkdir -- "$path" || { printf 'Cannot create product directory: %s\n' "$path" >&2; exit 4; }
    chmod 0755 "$path"
    chown "$uid:$gid" "$path"
  fi
  bash "$checker" "$root" "$relative" "$uid" directory || exit 4
done
