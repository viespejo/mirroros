# Native icon theme MirrorOS-default: the neutral default-device check and palette-colored folders, file types
# and devices generated by capabilities/visual/gtk4/icon-sources/generate.mjs; every other name from Adwaita.
[Icon Theme]
Name=MirrorOS-default
Comment=MirrorOS check, folders, file types and devices over Adwaita
Inherits=Adwaita,hicolor
Directories=16x16/status,scalable/status,symbolic/status,scalable/places,scalable/mimetypes,scalable/devices

[16x16/status]
Context=Status
Size=16
Type=Fixed

[scalable/status]
Context=Status
Size=128
MinSize=8
MaxSize=512
Type=Scalable

[symbolic/status]
Context=Status
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[scalable/places]
Context=Places
Size=128
MinSize=8
MaxSize=512
Type=Scalable

[scalable/mimetypes]
Context=MimeTypes
Size=128
MinSize=8
MaxSize=512
Type=Scalable

[scalable/devices]
Context=Devices
Size=128
MinSize=8
MaxSize=512
Type=Scalable
