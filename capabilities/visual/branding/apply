#!/usr/bin/bash
# Prerequisites: validated packages.
# Context: CONFIGURE_CONTEXT, CONFIGURE_ROOT, STEP_DIR and shared helpers.
# Postconditions: librsvg installed; /usr/share/mirroros/branding holds the wordmark SVG and the PNG rendered from it
# by the installed rsvg-convert, matching their last delivery. A rerun with the same source, renderer version and
# size renders nothing. Nothing is started, restarted or reloaded.
set -Eeuo pipefail

branding=/usr/share/mirroros/branding
svg="$STEP_DIR/mirroros-wordmark.svg"
# 20 pixels per wordmark unit (viewBox 79x16): every block edge stays on a pixel boundary.
width=1580 height=320
assets() { bash "$STEP_DIR/install-assets" "$@"; }

cfg_packages_ensure "$STEP_DIR/packages"
renderer="$(cfg_exec rsvg-convert --version)"
# librsvg 2.63 and later append the linked library versions after the first line.
renderer="${renderer%%$'\n'*}"
[[ "$renderer" =~ ^rsvg-convert\ version\ ([0-9][0-9A-Za-z.+~-]*)$ ]] || {
  printf 'Unrecognized rsvg-convert version output: %s\n' "$renderer" >&2
  exit 4
}
identity="svg-sha256:$(sha256sum < "$svg" | cut -d' ' -f1) rsvg-convert:${BASH_REMATCH[1]} size:${width}x$height"
owner="$(stat -c %u -- "$(cfg_path /)")"
group="$(stat -c %g -- "$(cfg_path /)")"
status=0
assets check "$svg" "$(cfg_path "$branding")" "$identity" || status=$?
case "$status" in
  0) ;;
  1)
    cfg_run_host bash "$STEP_DIR/install-assets" prepare "$svg" "$(cfg_path "$branding")" "$owner" "$group"
    staging="$(assets staging "$(cfg_path "$branding")")"
    # The installed renderer reads the staged source on stdin and writes the PNG on stdout, in either context.
    cfg_log "rsvg-convert --width $width --height $height < $svg > $branding/mirroros-wordmark.png"
    cfg_exec rsvg-convert --width "$width" --height "$height" < "$staging/mirroros-wordmark.svg" \
      > "$staging/mirroros-wordmark.png"
    cfg_run_host bash "$STEP_DIR/install-assets" publish "$svg" "$(cfg_path "$branding")" "$identity" \
      "$width" "$height" "$owner" "$group"
    cfg_changed ;;
  *) exit 4 ;;
esac
cfg_source_record mirroros-branding capabilities/visual/branding '' '' "$identity"

cfg_require cfg_packages_present "$STEP_DIR/packages"
cfg_require assets check "$svg" "$(cfg_path "$branding")" "$identity"
