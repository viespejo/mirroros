#!/usr/bin/bash
# managed by MirrorOS configure
# Build unprivileged. With no metadata, resolve it through chrome-channel first (configure).
# Output: package path, Arch version, .deb SHA256, InRelease date and signing subkey (TSV).
set -Eeuo pipefail
umask 077

fail() { printf 'Chrome build: %s\n' "$1" >&2; exit 4; }
(( EUID != 0 )) || fail 'run the build as the selected non-root user'
if [[ ${1-} == configure && $# == 1 ]]; then
  # configure streams this script on stdin after delivering the reviewed helper and recipe.
  here=/usr/share/mirroros/browser
  shift
else
  here=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
fi
if (( $# == 0 )); then
  if ! record=$("$here/chrome-channel"); then
    fail 'check the network or resolve the reported channel integrity failure, then rerun configure'
  fi
  IFS=$'\t' read -r version hash release_date subkey extra <<< "$record"
else
  (( $# == 4 )) || fail 'expected four verified metadata fields'
  version=$1 hash=$2 release_date=$3 subkey=$4 extra=''
fi
[[ "$version" =~ ^[0-9]+(\.[0-9]+){3}-[1-9][0-9]*$ && "$hash" =~ ^[0-9a-f]{64}$ &&
  "$release_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ &&
  "$subkey" =~ ^[0-9A-F]{40}$ && -z "$extra" ]] || fail 'invalid channel metadata; check chrome-channel'

cache_home=${XDG_CACHE_HOME:-$HOME/.cache}
[[ "$cache_home" == /* && "$cache_home" != *$'\t'* && "$cache_home" != *$'\n'* ]] || fail 'use a valid absolute cache path'
cache="$cache_home/mirroros/chrome"
mkdir -p -- "$cache" || fail 'make the Chrome cache writable and retry'
[[ ! -L "$cache" && -O "$cache" ]] || fail 'the Chrome cache must be a directory owned by this user, not a link'
work='' output='' built=0
cleanup() {
  [[ -z "$work" ]] || rm -rf -- "$work"
  [[ -z "$output" || "$built" == 1 ]] || rm -rf -- "$output"
  return 0
}
trap cleanup EXIT
trap 'exit 3' INT
trap 'exit 5' TERM HUP
work=$(mktemp -d "$cache/.build.XXXXXXXX") || fail 'cannot create a private build directory'
output=$(mktemp -d "$cache/package.XXXXXXXX") || fail 'cannot create a private package directory'
sed -e "s/@VERSION@/${version%-*}/g" -e "s/@RELEASE@/${version##*-}/g" -e "s/@DEB_SHA256@/$hash/g" \
  "$here/google-chrome/PKGBUILD" > "$work/PKGBUILD" || fail 'cannot render the reviewed recipe'
cp -- "$here/google-chrome/"{eula_text.html,google-chrome-stable.sh} "$work/" || fail 'cannot stage the reviewed sources'

export PACKAGER='MirrorOS Browser' PKGDEST="$output" SRCDEST="$work/sources" BUILDDIR="$work/build"
cd "$work"
package=$(makepkg --packagelist) || fail 'check the makepkg configuration and try again'
arch_version="$version.1"
[[ "$package" == "$output/google-chrome-$arch_version-x86_64.pkg.tar"* && "$package" != *$'\n'* &&
  "${package%/*}" == "$output" ]] || fail 'unexpected package list from makepkg'
makepkg --noconfirm --nocolor < /dev/null >&2 || fail 'review makepkg output and retry; Chrome was not installed'
[[ -f "$package" && ! -L "$package" ]] || fail 'makepkg did not produce a regular package file'
built=1
printf '%s\t%s\t%s\t%s\t%s\n' "$package" "$arch_version" "$hash" "$release_date" "$subkey"
