# managed by MirrorOS configure
# System default application associations for the desktop (DEC-014). This is the single owner: later Story 4.5
# plans extend this file instead of creating another association file. A user mimeapps.list takes precedence.
[Default Applications]
inode/directory=io.github.lgse.Strata.desktop
x-scheme-handler/http=google-chrome.desktop
x-scheme-handler/https=google-chrome.desktop
text/html=google-chrome.desktop
application/xhtml+xml=google-chrome.desktop
