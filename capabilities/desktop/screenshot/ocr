#!/usr/bin/bash
# managed by MirrorOS configure — provider-neutral direct OCR.
if (( $# )); then
  printf 'Usage: ocr\n' >&2
  exit 2
fi

backend=/usr/share/mirroros/compositor/ocr-backend
if [[ ! -x "$backend" ]]; then
  message='OCR backend is missing. Rerun mirroros-configure, then try again.'
  printf '%s\n' "$message" >&2
  # Capture menu Text glyph (U+F0D11), encoded as UTF-8 regardless of locale.
  notify-send --urgency=normal --hint=int:transient:1 --hint=$'string:omarchy-glyph:\xF3\xB0\xB4\x91' \
    'OCR failed' "$message" > /dev/null 2>&1 || :
  exit 1
fi

"$backend" > /dev/null 2>&1 && exit 0
printf 'OCR failed. Check journalctl --user -t mirroros-screenshot.\n' >&2
exit 1
