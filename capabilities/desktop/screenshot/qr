#!/usr/bin/bash
# managed by MirrorOS configure — provider-neutral QR decoding.
if (( $# )); then
  printf 'Usage: qr\n' >&2
  exit 2
fi

backend=/usr/share/mirroros/compositor/qr-backend
if [[ ! -x "$backend" ]]; then
  message='QR backend is missing. Rerun mirroros-configure, then try again.'
  printf '%s\n' "$message" >&2
  notify-send --urgency=normal --hint=int:transient:1 'QR capture failed' "$message" > /dev/null 2>&1 || :
  exit 1
fi

"$backend" > /dev/null 2>&1 && exit 0
printf 'QR capture did not complete. Check journalctl --user -t mirroros-screenshot.\n' >&2
exit 1
