#!/usr/bin/bash
# Run by the desktop/terminal step as the selected user (cfg_user_script). Terminal=true desktop entries started with
# `uwsm app` open in the first available terminal of the user's xdg-terminals.list. The desktop-specific Hyprland list
# takes precedence when it exists. A list naming no installed desktop entry is an actionable conflict, not a passing
# postcondition. Reads only these two list files and desktop-entry directories; writes nothing.
set -Eeuo pipefail

# The paths configure delivers to, not the invoking environment's XDG variables.
config="$HOME/.config"
list="$config/xdg-terminals.list"
[[ ! -e "$config/hyprland-xdg-terminals.list" ]] || list="$config/hyprland-xdg-terminals.list"
if [[ ! -r "$list" ]]; then
  printf 'Missing terminal preference %s; rerun configure or create it with foot.desktop.\n' "${list#"$HOME"/}" >&2
  exit 4
fi
data_dirs=("$HOME/.local/share" /usr/local/share /usr/share)
while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -n "$line" && "$line" != \#* ]] || continue
  id="${line#+}"
  id="${id%%:*}"
  [[ "$id" == *.desktop && "$id" != */* ]] || continue
  for dir in "${data_dirs[@]}"; do
    if [[ -f "$dir/applications/$id" ]]; then
      printf 'unchanged %s\n' "$id"
      exit 0
    fi
  done
done < "$list"
printf 'No installed terminal is listed in %s; add foot.desktop or an installed terminal entry, then rerun configure.\n' \
  "${list#"$HOME"/}" >&2
exit 4
