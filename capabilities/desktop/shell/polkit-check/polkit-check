#!/usr/bin/bash
# managed by MirrorOS configure
# Read-only check of the session's polkit authentication agent (Story 4.5, ADR 0030). Run it as the session user
# after a new login. It queries the user manager and the process table only: it never starts, stops or restarts the
# shell or an agent. The agent is hosted by the MirrorOS shell, so an inactive mirroros-shell.service or a running
# competing agent from the installed list is a failure naming the element and the expected owner. Registration of
# the agent itself is evidenced by attended prompts, not by this check.
# Exit 0 on pass, 1 on failure. MIRROROS_POLKIT_CHECK_ROOT prefixes the system paths read here; it is empty outside
# tests.
set -uo pipefail

root="${MIRROROS_POLKIT_CHECK_ROOT:-}"
agents="$root/usr/share/mirroros/polkit/agents"
status=0

ok() { printf 'ok: %s\n' "$*"; }
fail() { printf 'FAIL: %s\n' "$*" >&2; status=1; }

# 1. The shell unit, enabled by configure for graphical-session.target, hosts the agent.
state="$(systemctl --user is-active mirroros-shell.service 2>/dev/null)"
if [[ "$state" == active ]]; then ok 'mirroros-shell.service: active'
else fail "mirroros-shell.service: ${state:-unknown}; expected active, enabled by configure for graphical-session.target"; fi

# 2. No other known agent runs for this user, whatever started it (autostart entry, unit or personal autostart.lua).
# Full command lines are matched because process names are truncated to 15 characters.
if [[ ! -r "$agents" ]]; then
  fail "agent list: $agents missing; expected the copy installed by configure"
else
  competing=0
  while read -r name _ || [[ -n "$name" ]]; do
    [[ -n "$name" && "$name" != \#* ]] || continue
    pids="$(pgrep -u "$USER" -f -- "^([^ ]*/)?$name( |\$)" | tr '\n' ' ')"
    [[ -n "$pids" ]] || continue
    competing=1
    fail "competing agent: $name running (pid ${pids% }); expected the shell-hosted agent only"
  done < "$agents"
  (( competing )) || ok 'competing agents: none running'
fi

exit "$status"
