#!/usr/bin/bash
# Publishes the reviewed shell runtime as one tree. Run by the desktop/shell step on the host side (paths below the
# configure root); never by the shell itself.
#
#   install-runtime digest  <source>                 SHA256 of the source manifest (evidence identity)
#   install-runtime check   <source> <dest>          0 current, 1 publish needed, 4 conflict
#   install-runtime publish <source> <dest> <uid> <gid>
#
# The runtime is every regular file of <source> except the delivery files below, with unchanged bytes, mode 0755
# when the source file is executable (services/hidden-entries.sh is run directly) or 0644, and directories 0755. <dest>/.mirroros-manifest records the delivered tree, so a local edit is detected without
# a header: reused upstream files stay byte-identical. A tree is published only when <dest> is absent or is the
# intact previous delivery; a link, an unknown directory or a modified delivery is never overwritten. The new tree
# is staged beside <dest>, verified, then exchanged atomically, so an interruption leaves either the previous or the
# new complete tree, never a mixed one. Leftover staging from an interrupted run is removed on the next run.
set -Eeuo pipefail
export LC_ALL=C

readonly manifest_name=.mirroros-manifest staging_prefix=.shell.mirroros-staging.

usage() { printf 'Usage: install-runtime digest|check|publish <source> [<dest> [<uid> <gid>]]\n' >&2; exit 6; }

# "<kind> <mode> <sha256|-> <path>" for every runtime entry, sorted; delivery files are excluded from a source.
source_manifest() {
  local source="$1" kind mode path
  ( cd -- "$source" && find . -mindepth 1 \( -path ./apply -o -path ./packages -o -path ./install-runtime \
      -o -path ./systemd \) -prune -o -printf '%y %m %p\n' ) | sort -k3 | while read -r kind mode path; do
    case "$kind" in
      d) printf 'd 755 - %s\n' "$path" ;;
      f)
        if (( 8#$mode & 8#111 )); then mode=755; else mode=644; fi
        printf 'f %s %s %s\n' "$mode" "$(sha256sum < "$source/$path" | cut -d' ' -f1)" "$path" ;;
      *) printf 'Unsupported source entry: %s\n' "$path" >&2; return 6 ;;
    esac
  done
}

# The same lines for an installed tree, with its actual kinds and modes; any link or special file is reported.
tree_manifest() {
  local dest="$1" kind mode path
  ( cd -- "$dest" && find . -mindepth 1 ! -path "./$manifest_name" -printf '%y %m %p\n' ) | sort -k3 |
    while read -r kind mode path; do
      case "$kind" in
        d) printf 'd %s - %s\n' "$mode" "$path" ;;
        f) printf 'f %s %s %s\n' "$mode" "$(sha256sum < "$dest/$path" | cut -d' ' -f1)" "$path" ;;
        *) printf '%s %s - %s\n' "$kind" "$mode" "$path" ;;
      esac
    done
}

sorted() { sort -k4; }

check() {
  local source="$1" dest="$2" wanted actual
  [[ -e "$dest" || -L "$dest" ]] || return 1
  if [[ -L "$dest" || ! -d "$dest" || ! -f "$dest/$manifest_name" || -L "$dest/$manifest_name" ]]; then
    printf 'Conflict: %s is not a shell runtime delivered by MirrorOS; move it aside, then rerun configure.\n' "$dest" >&2
    return 4
  fi
  actual="$(tree_manifest "$dest" | sorted)"
  if [[ "$actual" != "$(sorted < "$dest/$manifest_name")" ]]; then
    printf 'Conflict: %s differs from its last MirrorOS delivery (local edit); move it aside or restore it, then rerun configure.\n' "$dest" >&2
    return 4
  fi
  wanted="$(source_manifest "$source" | sorted)"
  [[ "$actual" == "$wanted" ]] || return 1
}

publish() {
  local source="$1" dest="$2" uid="$3" gid="$4" parent staging status=0 kind mode path
  [[ "$uid" =~ ^[0-9]+$ && "$gid" =~ ^[0-9]+$ ]] || usage
  check "$source" "$dest" || status=$?
  case "$status" in 0) return 0 ;; 1) ;; *) return "$status" ;; esac
  parent="$(dirname -- "$dest")"
  install -d -m 0755 -o "$uid" -g "$gid" -- "$parent"
  find "$parent" -mindepth 1 -maxdepth 1 -name "$staging_prefix*" -exec rm -rf -- {} +
  staging="$(mktemp -d "$parent/${staging_prefix}XXXXXX")"
  chmod 0755 "$staging"
  chown "$uid:$gid" "$staging"
  source_manifest "$source" > "$staging/$manifest_name"
  while read -r kind mode _ path; do
    if [[ "$kind" == d ]]; then
      install -d -m 0755 -o "$uid" -g "$gid" -- "$staging/$path"
    else
      install -m "0$mode" -o "$uid" -g "$gid" -- "$source/$path" "$staging/$path"
    fi
  done < "$staging/$manifest_name"
  chmod 0644 "$staging/$manifest_name"
  chown "$uid:$gid" "$staging/$manifest_name"
  if [[ "$(tree_manifest "$staging" | sorted)" != "$(sorted < "$staging/$manifest_name")" ]]; then
    printf 'The staged shell runtime does not match its manifest.\n' >&2
    return 5
  fi
  if [[ -e "$dest" ]]; then
    mv --exchange -T -- "$staging" "$dest"
    rm -rf -- "$staging"
  else
    mv -T -- "$staging" "$dest"
  fi
  check "$source" "$dest"
}

(( $# >= 2 )) || usage
[[ -d "$2" && ! -L "$2" ]] || { printf 'Missing shell runtime source: %s\n' "$2" >&2; exit 6; }
case "$1" in
  digest) (( $# == 2 )) || usage; source_manifest "$2" | sorted | sha256sum | cut -d' ' -f1 ;;
  check) (( $# == 3 )) || usage; check "$2" "$3" ;;
  publish) (( $# == 5 )) || usage; publish "$2" "$3" "$4" "$5" ;;
  *) usage ;;
esac
