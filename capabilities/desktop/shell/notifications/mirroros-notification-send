#!/bin/bash

set -euo pipefail

headline=""
description=""
glyph=
urgency="low"
app_name="mirroros-action"
app_icon=""
image=
expire_timeout=-1
replaces_id=0
print_id=0
transient=0
parsed_option_args=0

usage() {
  echo "Usage: mirroros-notification-send [--app-name <app-name>] [-g <glyph>] [-u <low|normal|critical>] [-i <icon>] [-t <ms>] [-r <id>] [-p] [--transient] [--image <path-or-uri>] [--] <headline> [description]" >&2
}

reject_executable_option() {
  case ${1%%=*} in
  --exec | --action | --with)
    echo 'Executable actions are not supported.' >&2
    exit 2
    ;;
  esac
}

# Recognize known options in both `--flag value` and `--flag=value` forms.
parse_option() {
  local opt val nargs
  reject_executable_option "$1"
  if [[ $1 == --?*=* ]]; then
    opt=${1%%=*}
    val=${1#*=}
    nargs=1
  else
    opt=$1
    val=${2-}
    nargs=2
  fi

  # Flags take no value: --transient=false must not switch it on.
  case $1 in
  -p | --print-id)
    print_id=1
    parsed_option_args=1
    return 0
    ;;
  --transient)
    transient=1
    parsed_option_args=1
    return 0
    ;;
  esac

  case $opt in
  -g | --glyph | -u | --urgency | --app-name | -i | --icon | --image | -r | --replace-id | -t | --expire-time) ;;
  *) return 1 ;;
  esac

  if ((nargs == 2)) && (($# < 2)); then
    echo "Missing value for $opt" >&2
    exit 1
  fi

  case $opt in
  -g | --glyph) glyph=$val ;;
  -u | --urgency) urgency=$val ;;
  --app-name) app_name=$val ;;
  -i | --icon) app_icon=$val ;;
  --image) image=$val ;;
  -r | --replace-id)
    [[ $val =~ ^[0-9]+$ ]] || {
      echo "Invalid $opt value (numeric id expected): $val" >&2
      exit 1
    }
    replaces_id=$val
    ;;
  -t | --expire-time)
    [[ $val =~ ^-?[0-9]+$ ]] || {
      echo "Invalid $opt value (milliseconds expected): $val" >&2
      exit 1
    }
    expire_timeout=$val
    ;;
  esac

  parsed_option_args=$nargs
  return 0
}

while (($# > 0)); do
  if [[ $1 == "-h" || $1 == "--help" ]]; then
    usage 2>&1
    exit 0
  elif [[ $1 == -- ]]; then
    break
  elif parse_option "$@"; then
    shift "$parsed_option_args"
  elif [[ $1 == -* ]]; then
    echo "Unknown option: $1" >&2
    usage
    exit 1
  else
    break
  fi
done

# After --, all remaining words are literal headline/body, not sender options.
literal=0
if [[ ${1-} == -- ]]; then
  literal=1
  shift
fi
if (($# < 1 || (literal && $# > 2))); then
  usage
  exit 1
fi

headline=$1
shift

# A dash-leading body is text unless it matches a sender option. Use -- to
# display an exact option spelling as text.
known_flag() {
  reject_executable_option "$1"
  case $1 in
  -g | --glyph | -u | --urgency | --app-name | -i | --icon | -t | --expire-time | --image | -r | --replace-id | -p | --print-id | --transient) return 0 ;;
  --glyph=* | --urgency=* | --app-name=* | --icon=* | --expire-time=* | --image=* | --replace-id=*) return 0 ;;
  esac
  return 1
}

if (($# > 0)) && { ((literal)) || ! known_flag "$1"; }; then
  description=$1
  shift
fi

while (($# > 0)); do
  if parse_option "$@"; then
    shift "$parsed_option_args"
  else
    echo "Unknown option: $1" >&2
    usage
    exit 1
  fi
done

case $urgency in
low) urgency_byte=0 ;;
normal) urgency_byte=1 ;;
critical) urgency_byte=2 ;;
*)
  echo "Unknown urgency: $urgency (use low, normal, or critical)" >&2
  exit 1
  ;;
esac

# a{sv} hints, as busctl triples (key, variant type, value).
hints=(urgency y "$urgency_byte")

if [[ -n $glyph ]]; then
  hints+=(mirroros-glyph s "$glyph")
fi

if [[ -n $image ]]; then
  hints+=(image-path s "$image")
fi

if ((transient)); then
  hints+=(transient b true)
fi

hint_count=$((${#hints[@]} / 3))

# Each value is a typed D-Bus parameter, not a notify-send option or hint.
# Signature: app name, replaces id, icon, summary, body, empty actions, hints,
# timeout. busctl uses the caller's session bus and treats values after -- as
# positional, including a dash-leading body or timeout.
notify_cmd=(
  busctl --user -- call
  org.freedesktop.Notifications /org/freedesktop/Notifications
  org.freedesktop.Notifications Notify susssasa{sv}i
  "$app_name" "$replaces_id" "$app_icon" "$headline" "$description"
  0
  "$hint_count" "${hints[@]}"
  "$expire_timeout"
)

if ((print_id)); then
  # busctl prints the UINT32 return as "u <id>"; emit just the id.
  out=$("${notify_cmd[@]}")
  printf '%s\n' "${out##* }"
else
  "${notify_cmd[@]}" >/dev/null
fi
