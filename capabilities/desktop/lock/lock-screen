#!/usr/bin/bash
# managed by MirrorOS configure
# Run by hypridle's lock_cmd. Locks in the first layout (the configured one, decision J(a) and ADR 0015) and restores
# the layout that was active before locking once hyprlock exits after unlocking. A failure to read or switch the
# layout never prevents locking; without a recorded layout nothing is restored. Exits with hyprlock's status.
# Before locking it also writes the field geometry for the focused monitor's scale (DEC-012).
set -uo pipefail
export LC_ALL=C

# hyprlock lays out in physical pixels, so the 378x57 logical field and its 3 logical-pixel border are converted with
# the focused monitor's scale (the first monitor when none is focused) into the file the lock configuration sources.
# The file is replaced atomically; when the scale cannot be read it is removed and the configuration's fallbacks
# apply. A failure here never prevents locking.
write_geometry() {
  local geometry="$1" scale values tmp
  scale="$(hyprctl monitors -j 2> /dev/null | awk '
    /"scale":/ { value = $0; sub(/.*"scale":[[:space:]]*/, "", value); sub(/[,[:space:]].*/, "", value); if (first == "") first = value; last = value }
    /"focused":[[:space:]]*true/ { focused = last }
    END { print (focused != "" ? focused : first) }
  ')"
  if [[ "$scale" =~ ^[0-9]+(\.[0-9]+)?$ ]] \
    && values="$(awk -v scale="$scale" 'BEGIN {
      if (scale <= 0) exit 1
      printf "$field_size = %d, %d\n$field_border = %d\n", 378 * scale + 0.5, 57 * scale + 0.5, 3 * scale + 0.5
    }')" \
    && mkdir -p -- "${geometry%/*}" \
    && tmp="$(mktemp -- "$geometry.XXXXXX")"; then
    if printf '# generated by MirrorOS lock-screen for scale %s; replaced on every lock\n%s\n' "$scale" "$values" > "$tmp" \
      && mv -f -- "$tmp" "$geometry"; then
      return 0
    fi
    rm -f -- "$tmp"
  fi
  rm -f -- "$geometry"
}

if [[ -n "${HOME:-}" ]]; then
  write_geometry "$HOME/.cache/mirroros/lock/geometry.conf" 2> /dev/null
fi

# Active layout index of the main keyboard from hyprctl's JSON, or of the first keyboard when none is marked main.
index="$(hyprctl devices -j 2> /dev/null | awk '
  /"active_layout_index":/ { value = $0; gsub(/[^0-9]/, "", value); if (first == "") first = value; last = value }
  /"main":[[:space:]]*true/ { main = last }
  END { print (main != "" ? main : first) }
')"
hyprctl switchxkblayout all 0 > /dev/null 2>&1
hyprlock
status=$?
if [[ "$index" =~ ^[0-9]+$ ]]; then
  hyprctl switchxkblayout all "$index" > /dev/null 2>&1
fi
exit "$status"
