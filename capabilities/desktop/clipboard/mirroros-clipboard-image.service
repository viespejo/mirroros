# managed by MirrorOS configure
[Unit]
Description=MirrorOS PNG clipboard history watcher
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/wl-paste --type image/png --watch /usr/share/mirroros/clipboard/clipboard-history store image/png
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
