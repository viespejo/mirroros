#!/usr/bin/bash
# Prerequisites: validated packages and XKB layout; upstream Lua API and uwsm session entry.
# Context: CONFIGURE_CONTEXT, CONFIGURE_ROOT, TARGET_USER, STEP_DIR and shared helpers.
# Postconditions: packages and configuration exist; the approved bindings match their last delivery;
# exactly one uwsm session is listed.
set -Eeuo pipefail

cfg_packages_ensure "$STEP_DIR/packages"
cfg_local_package_ensure omasnap "$STEP_DIR/omasnap/PKGBUILD" "$STEP_DIR/omasnap/build-omasnap"
cfg_source_record omasnap 'https://github.com/omacom/omasnap/archive/refs/tags/v1.26.2.tar.gz' \
  v1.26.2 6150151846b0ddc2ca8e6b107324de8b0c7240ae "$(cfg_recipe_version "$STEP_DIR/omasnap/PKGBUILD")"
cfg_system_file "$STEP_DIR/omasnap/screenshot-backend" /usr/share/mirroros/compositor/screenshot-backend 0755
for action in color ocr qr; do
  cfg_tracked_file "$STEP_DIR/capture-extras/$action-backend" "/usr/share/mirroros/compositor/$action-backend" 0755
done
ocr_languages_file="$(cfg_path /usr/share/mirroros/compositor/ocr-languages)"
if [[ -L "$ocr_languages_file" || ( -e "$ocr_languages_file" && ! -f "$ocr_languages_file" ) ]]; then
  printf 'Conflict: ocr-languages is not a regular file; move it aside, then rerun configure.\n' >&2
  exit 4
fi
ocr_languages_owner="$(stat -c '%u:%g' -- "$(cfg_path /)")"
if ! cmp -s -- "$ocr_languages_file" <(printf '%s\n' "$CFG_HYPRLAND_OCR_LANGUAGES") ||
  [[ "$(stat -c '%a:%u:%g' -- "$ocr_languages_file")" != "644:$ocr_languages_owner" ]]; then
  cfg_run_host install -o "${ocr_languages_owner%:*}" -g "${ocr_languages_owner#*:}" -m 0644 -- \
    <(printf '%s\n' "$CFG_HYPRLAND_OCR_LANGUAGES") "$ocr_languages_file"
  cfg_changed
fi
cfg_system_file "$STEP_DIR/omasnap/60-mirroros-omasnap.conf" /etc/environment.d/60-mirroros-omasnap.conf 0644
cfg_user_file "$STEP_DIR/omasnap/omasnap.conf" .config/omasnap/omasnap.conf
if [[ "$CONFIGURE_CONTEXT" == target ]]; then session=--default; else session=--session; fi
cfg_user_script "$CAPABILITIES_DIR/visual/theme/omarchy-bridge" apply "$session" || exit 4
cfg_tracked_file "$STEP_DIR/omasnap/screenshot-bindings.lua" /usr/share/mirroros/hypr/screenshot-bindings.lua 0644
cfg_system_file "$STEP_DIR/keyboard.lua" /usr/share/mirroros/hypr/keyboard.lua 0644
cfg_system_file "$STEP_DIR/layouts.lua" /usr/share/mirroros/hypr/layouts.lua 0644
cfg_system_file "$STEP_DIR/monitors.lua" /usr/share/mirroros/hypr/monitors.lua 0644
cfg_system_file "$STEP_DIR/greeter/hyprland.lua" /usr/share/mirroros/sddm/hyprland.lua 0644
cfg_system_file "$STEP_DIR/greeter/layout-indicator" /usr/share/mirroros/sddm/layout-indicator 0755
cfg_tracked_file "$STEP_DIR/shell-bindings.lua" /usr/share/mirroros/hypr/shell-bindings.lua 0644
cfg_tracked_file "$STEP_DIR/window-bindings.lua" /usr/share/mirroros/hypr/window-bindings.lua 0644
cfg_tracked_file "$STEP_DIR/hardware-bindings.lua" /usr/share/mirroros/hypr/hardware-bindings.lua 0644
cfg_tracked_file "$STEP_DIR/clipboard-bindings.lua" /usr/share/mirroros/hypr/clipboard-bindings.lua 0644
cfg_system_file "$STEP_DIR/display" /usr/share/mirroros/hardware/display 0755
cfg_tracked_file "$STEP_DIR/theme-loader.lua" /usr/share/mirroros/hypr/theme-loader.lua 0644
cfg_tracked_file "$STEP_DIR/theme-validation.lua" /usr/share/mirroros/hypr/theme-validation.lua 0644
cfg_tracked_file "$STEP_DIR/theme-runtime.lua" /usr/share/mirroros/hypr/theme-runtime.lua 0644
cfg_tracked_file "$STEP_DIR/defaults.lua" /usr/share/mirroros/hypr/defaults.lua 0644
cfg_tracked_file "$STEP_DIR/personal-loader.lua" /usr/share/mirroros/hypr/personal-loader.lua 0644
cfg_user_script "$STEP_DIR/prepare-hyprland" "$(base64 -w 0 < "$STEP_DIR/hyprland.lua")"
[[ "$CFG_USER_SCRIPT_RESULT" != 'unchanged user-owned:'* ]] || cfg_log "$CFG_USER_SCRIPT_RESULT"
cfg_user_script "$STEP_DIR/prepare-monitors" "$(base64 -w 0 < "$STEP_DIR/personal-monitors.lua")"
[[ "$CFG_USER_SCRIPT_RESULT" != 'unchanged user-owned:'* ]] || cfg_log "$CFG_USER_SCRIPT_RESULT"
cfg_user_script "$STEP_DIR/prepare-bindings" "$(base64 -w 0 < "$STEP_DIR/personal-bindings.lua")"
[[ "$CFG_USER_SCRIPT_RESULT" != 'unchanged user-owned:'* ]] || cfg_log "$CFG_USER_SCRIPT_RESULT"
cfg_system_link /usr/share/wayland-sessions/hyprland-uwsm.desktop /usr/share/mirroros/wayland-sessions/hyprland-uwsm.desktop
cfg_system_file "$STEP_DIR/sddm/20-mirroros-hyprland.conf" /etc/sddm.conf.d/20-mirroros-hyprland.conf 0644
cfg_system_file "$STEP_DIR/hyprland-portals.conf" /etc/xdg/xdg-desktop-portal/hyprland-portals.conf 0644
cfg_user_file "$STEP_DIR/xdph.conf" .config/hypr/xdph.conf

cfg_require cfg_packages_present "$STEP_DIR/packages"
cfg_require cfg_local_package_present omasnap "$STEP_DIR/omasnap/PKGBUILD"
cfg_require cfg_system_file_present /usr/share/mirroros/compositor/screenshot-backend
for action in color ocr qr; do
  cfg_require cfg_tracked_file_present "/usr/share/mirroros/compositor/$action-backend"
done
cfg_require cmp -s -- "$ocr_languages_file" <(printf '%s\n' "$CFG_HYPRLAND_OCR_LANGUAGES")
cfg_require cfg_system_file_present /etc/environment.d/60-mirroros-omasnap.conf
cfg_require cfg_user_file_present .config/omasnap/omasnap.conf
cfg_require cfg_user_script "$CAPABILITIES_DIR/visual/theme/omarchy-bridge" check "$session"
cfg_require cfg_tracked_file_present /usr/share/mirroros/hypr/screenshot-bindings.lua
cfg_require cfg_system_file_present /usr/share/mirroros/hypr/keyboard.lua
cfg_require cfg_system_file_present /usr/share/mirroros/hypr/layouts.lua
cfg_require cfg_system_file_present /usr/share/mirroros/hypr/monitors.lua
cfg_require cfg_system_file_present /usr/share/mirroros/sddm/hyprland.lua
cfg_require cfg_system_file_present /usr/share/mirroros/sddm/layout-indicator
cfg_require cfg_tracked_file_present /usr/share/mirroros/hypr/shell-bindings.lua
cfg_require cfg_tracked_file_present /usr/share/mirroros/hypr/window-bindings.lua
cfg_require cfg_tracked_file_present /usr/share/mirroros/hypr/hardware-bindings.lua
cfg_require cfg_tracked_file_present /usr/share/mirroros/hypr/clipboard-bindings.lua
cfg_require cfg_system_file_present /usr/share/mirroros/hardware/display
cfg_require cfg_tracked_file_present /usr/share/mirroros/hypr/theme-loader.lua
cfg_require cfg_tracked_file_present /usr/share/mirroros/hypr/theme-validation.lua
cfg_require cfg_tracked_file_present /usr/share/mirroros/hypr/theme-runtime.lua
cfg_require cfg_tracked_file_present /usr/share/mirroros/hypr/defaults.lua
cfg_require cfg_tracked_file_present /usr/share/mirroros/hypr/personal-loader.lua
cfg_require cfg_user_file_present .config/hypr/hyprland.lua
cfg_require cfg_system_file_present /etc/sddm.conf.d/20-mirroros-hyprland.conf
cfg_require cfg_system_file_present /etc/xdg/xdg-desktop-portal/hyprland-portals.conf
cfg_require cfg_user_file_present .config/hypr/xdph.conf
cfg_require cfg_session_is_only /usr/share/mirroros/wayland-sessions hyprland-uwsm.desktop 'uwsm start' hyprland.desktop
