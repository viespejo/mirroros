#!/usr/bin/bash
# Run as the target user. The argument is the reviewed configuration encoded as base64.
set -Eeuo pipefail
umask 022
readonly legacy=4f152e77e8a11029ad07686e62445d780360ba34c84cfd772640c8f610b56eb0
readonly jade_legacy=4f77f9fd2dc4b8260fb7fde5d5b073b9ab0420515a23da5dfa92752d55acc744
readonly theme_legacy=9c7ac92d0345509d2c0fe25cabf8f80f192af4ac68de218cec0a053a20a14d27
dest="$HOME/.config/hypr/hyprland.lua"
old="$HOME/.config/hypr/hyprland.conf"
if [[ -L "$dest" || ( -e "$dest" && ! -f "$dest" ) || -e "$old" || -L "$old" ]]; then
  printf 'unchanged user-owned: .config/hypr/hyprland configuration; left untouched\n'
  exit 0
fi
mkdir -p -- "${dest%/*}"
tmp=$(mktemp "${dest%/*}/.mirroros-hyprland.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT
printf '%s' "$1" | base64 -d > "$tmp"
if [[ -f "$dest" ]]; then
  if cmp -s -- "$tmp" "$dest"; then
    printf 'unchanged\n'
    exit 0
  fi
  current=$(sha256sum < "$dest")
  if [[ ${current%% *} != "$legacy" && ${current%% *} != "$jade_legacy" && ${current%% *} != "$theme_legacy" ]]; then
    printf 'unchanged user-owned: .config/hypr/hyprland configuration; left untouched\n'
    exit 0
  fi
fi
chmod 0644 "$tmp"
mv -T -- "$tmp" "$dest"
printf 'changed\n'
