#!/usr/bin/bash
# managed by MirrorOS configure
# Read-only battery details adapted from Omarchy v4.5.0 omarchy-battery-status --shell
# (MIT, Copyright (c) David Heinemeier Hansson); values are machine-readable and untranslated.
set -Eeuo pipefail

usage() { printf 'Usage: battery-status\n' >&2; exit 2; }
unavailable() { printf 'Battery unavailable: %s\n' "$1" >&2; exit 4; }
(( $# == 0 )) || usage
power_supply_path=${MIRROROS_POWER_SUPPLY_PATH:-/sys/class/power_supply}

# Match UPower battery devices by class and keep the first that powers the machine: peripherals are
# battery_ devices too, marked "power supply: no".
battery_info=''
# UPower writes decimals in the session's LC_NUMERIC ("49,22 Wh"); parse its C-locale output.
devices=$(LC_ALL=C upower -e 2> /dev/null) || unavailable 'UPower is not accessible.'
while IFS= read -r candidate; do
  [[ "$candidate" == */battery_* ]] || continue
  info=$(LC_ALL=C upower -i "$candidate" 2> /dev/null) || continue
  if grep -qE '^[[:space:]]*power supply:[[:space:]]+yes' <<< "$info"; then
    battery_info=$info
    break
  fi
done <<< "$devices"
[[ -n "$battery_info" ]] || unavailable 'no system battery.'

field() { awk -v key="$1" '$1 == key ":" { print $2; exit }' <<< "$battery_info"; }
percentage=$(awk '/^[[:space:]]*percentage:/ { gsub(/%/, "", $2); print int($2); exit }' <<< "$battery_info")
[[ "$percentage" =~ ^[0-9]+$ ]] || unavailable 'invalid battery percentage.'
state=$(field state)
[[ "$state" =~ ^[a-z-]+$ ]] || unavailable 'invalid battery state.'
energy=$(field energy)
energy_full=$(field energy-full)
rate_raw=$(field energy-rate)
upower_hours=$(awk '/time to (empty|full):/ { print ($5 ~ /^minute/ ? $4 / 60 : $4); exit }' <<< "$battery_info")
native_path=$(field native-path)
battery_path=''
[[ ! "$native_path" =~ ^[A-Za-z0-9._:-]+$ ]] || battery_path="$power_supply_path/$native_path"
upower_threshold_start=$(awk '/charge-start-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<< "$battery_info")
upower_threshold_end=$(awk '/charge-end-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<< "$battery_info")

read_number() {
  local value
  [[ -n "$battery_path" ]] || return 1
  { value=$(< "$battery_path/$1"); } 2> /dev/null || return 1
  [[ "$value" =~ ^-?[0-9]+$ ]] || return 1
  printf '%s\n' "$value"
}
# Prefer the instantaneous kernel reading; UPower's averaged rate can lag by tens of seconds.
if microwatts=$(read_number power_now); then
  rate_raw=$(awk -v value="$microwatts" 'BEGIN { print value / 1000000 }')
elif microamps=$(read_number current_now) && microvolts=$(read_number voltage_now); then
  rate_raw=$(awk -v a="$microamps" -v v="$microvolts" 'BEGIN { print a * v / 1000000000000 }')
fi
# The kernel signs the rate on some platforms; the state already carries the direction.
rate=$(awk -v rate="${rate_raw:-0}" 'BEGIN { if (rate < 0) rate = -rate; r = sprintf("%.1f", rate); sub(/\.0$/, "", r); print r }')
# The kernel holds the thresholds the firmware applies; UPower publishes its own policy values even when
# ChargeThresholdEnabled is false, so it is only a fallback when the battery exposes no thresholds.
if threshold_end=$(read_number charge_control_end_threshold); then
  threshold_start=$(read_number charge_control_start_threshold || true)
else
  threshold_end=$upower_threshold_end
  threshold_start=$upower_threshold_start
fi
charge_limit=${threshold_end:-100}

# Time left follows the displayed rate; charging counts to this battery's own charge limit.
minutes=$(awk -v energy="$energy" -v full="$energy_full" -v rate="${rate_raw:-0}" -v state="$state" \
    -v limit="$charge_limit" -v fallback="$upower_hours" 'BEGIN {
  if (rate < 0) rate = -rate
  if (energy != "" && full != "" && rate > 0.2) {
    hours = state == "charging" ? (full * limit / 100 - energy) / rate : energy / rate
  } else hours = fallback
  if (hours == "" || hours <= 0) exit
  printf "%d", int(hours * 60 + 0.5)
}')

ac_online=false
for supply in "$power_supply_path"/*; do
  [[ -r "$supply/type" && -r "$supply/online" ]] || continue
  if [[ $(< "$supply/type") == Mains && $(< "$supply/online") == 1 ]]; then ac_online=true; break; fi
done
idle=false
awk -v rate="${rate_raw:-0}" 'BEGIN { if (rate < 0) rate = -rate; exit !(rate <= 0.2) }' && idle=true
# A charge threshold holds the battery below full on AC; UPower reports that inconsistently.
if [[ "$ac_online" == true && -n "$threshold_end" ]]; then
  if [[ "$state" == pending-charge ]] ||
      { [[ "$state" == fully-charged ]] && (( percentage < 99 )); } ||
      { [[ "$state" == charging && "$idle" == true ]] && (( threshold_end < 99 && percentage >= threshold_end )); }; then
    state=holding
  fi
fi

printf 'percentage\t%s\n' "$percentage"
printf 'state\t%s\n' "$state"
printf 'rate\t%s\n' "$rate"
[[ ! "$energy_full" =~ ^[0-9.]+$ ]] || printf 'size\t%d\n' "${energy_full%%.*}"
cycles=$(read_number cycle_count || true)
[[ -z "$cycles" || "$cycles" -lt 0 ]] || printf 'cycles\t%s\n' "$cycles"
if [[ -n "$threshold_end" ]]; then
  if [[ -n "$threshold_start" && "$threshold_start" != "$threshold_end" ]]; then
    printf 'threshold\t%s-%s\n' "$threshold_start" "$threshold_end"
  else
    printf 'threshold\t%s\n' "$threshold_end"
  fi
fi
[[ -z "$minutes" ]] || printf 'time\t%s\n' "$minutes"
