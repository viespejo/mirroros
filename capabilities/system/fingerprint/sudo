#%PAM-1.0
# managed by MirrorOS configure
# Fingerprint first, then the packaged sudo stack (ADR 0030). The clamshell gate skips pam_fprintd while the lid
# is closed; any other gate result, including a probe error, continues to pam_fprintd (default=ignore).
auth [success=1 default=ignore] pam_exec.so quiet /usr/share/mirroros/hardware/lid-closed
auth sufficient pam_fprintd.so
auth		include		system-auth
account		include		system-auth
session		include		system-auth
session		optional	pam_systemd.so class=none
